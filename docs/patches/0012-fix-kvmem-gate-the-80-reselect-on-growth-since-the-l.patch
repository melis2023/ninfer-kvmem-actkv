From 0b69870e9790e190701cde9a5cce2aa6e47239e6 Mon Sep 17 00:00:00 2001
From: kvmem <kvmem@local>
Date: Sun, 25 Oct 2026 23:13:02 +0800
Subject: [PATCH] fix(kvmem): gate the 80% reselect on growth since the last
 compaction

When B > 4R the compaction target itself sits above the 80% high-water mark, so every append reselected without removing anything. Require visible - last_reselect_visible > R/2, update the baseline after reselect/async publish/checkpoint restore, and warn at startup when budget > 4 * reserve.
---
 src/models/qwen3_5/program/program_impl.h         |  4 ++++
 .../qwen3_5/program/storage/kvmem_window.cpp      | 15 ++++++++++++++-
 src/runtime/engine/model_instance.cpp             | 10 ++++++++++
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/models/qwen3_5/program/program_impl.h b/src/models/qwen3_5/program/program_impl.h
index c0301d6e..06ac32a9 100644
--- a/src/models/qwen3_5/program/program_impl.h
+++ b/src/models/qwen3_5/program/program_impl.h
@@ -563,6 +563,10 @@ struct KvmemWindowState {
     std::uint64_t payload_bytes = 0;
     std::uint64_t spilled_bytes = 0, restored_bytes = 0;
     std::uint32_t removed_tokens = 0;
+    // Compact position observed at the last reselection. The 80% high-water trigger must also
+    // require growth past this point; otherwise a compaction that lands above 80% (B > 4R)
+    // reselects on every step without removing anything.
+    std::uint32_t last_reselect_visible = 0;
     std::uint32_t swaps = 0;
     std::unique_ptr<kvmem::RawKvStore> statistics;
     std::unique_ptr<kvmem::KvMemStore> selector;
diff --git a/src/models/qwen3_5/program/storage/kvmem_window.cpp b/src/models/qwen3_5/program/storage/kvmem_window.cpp
index 2a21931f..5116e2f1 100644
--- a/src/models/qwen3_5/program/storage/kvmem_window.cpp
+++ b/src/models/qwen3_5/program/storage/kvmem_window.cpp
@@ -689,6 +689,7 @@ bool ProgramImpl::prepare_window(SequenceState& sequence, std::uint32_t begin, s
         }
         pending->publish();
         pending.reset();
+        sequence.window.last_reselect_visible = compact_position(sequence, end);
         force_selection = false;
     }
     if (end == begin && !force_selection) { return true; }
@@ -696,10 +697,20 @@ bool ProgramImpl::prepare_window(SequenceState& sequence, std::uint32_t begin, s
     // follows instead of stalling the request at 100%. Selection is unchanged; only
     // the trigger moves earlier. A completed swap compacts the view back to
     // selected_tokens, which leaves the reserve free for the next segment.
+    //
+    // The high-water test alone thrashes when compaction lands above it (B > 4R): the
+    // next step is already past 80%, so every append reselects without removing anything.
+    // Require real growth since the last compaction as well; a safe B < 4R config grows
+    // by at least R/2 before reaching the water mark, so its trigger is unchanged.
     const std::uint32_t reselect_high_water =
         kvmem_window_tokens - kvmem_window_tokens / 5;
+    const std::uint32_t visible = compact_position(sequence, end);
+    const bool grew_since_reselect =
+        visible >= sequence.window.last_reselect_visible &&
+        visible - sequence.window.last_reselect_visible >
+            kvmem_options.reserve_tokens / 2;
     const bool reselecting =
-        force_selection || compact_position(sequence, end) > reselect_high_water;
+        force_selection || (visible > reselect_high_water && grew_since_reselect);
     long long reselect_score_us = 0;
     long long reselect_select_us = 0;
     if (reselecting) {
@@ -798,6 +809,7 @@ bool ProgramImpl::prepare_window(SequenceState& sequence, std::uint32_t begin, s
         session.prepare(backend->stamp(), selected, mandatory, budget);
         while (session.advance() != kvmem::MemoryPhase::Ready) {}
         session.publish();
+        sequence.window.last_reselect_visible = compact_position(sequence, end);
         std::fprintf(stderr,
             "KVMEM_RESELECT logical=%u blocks=%llu score_us=%lld select_us=%lld transfer_us=%lld "
             "selected=%zu\n",
@@ -1120,6 +1132,7 @@ void ProgramImpl::restore_memory_prefix(SequenceState& sequence, const KvmemPref
                 memory_io->wait_for_completion(epoch, std::chrono::milliseconds(1));
         }
         session.publish();
+        sequence.window.last_reselect_visible = compact_position(sequence, frontier);
     } else {
         prepare_window(sequence, frontier, frontier, true, allow_pending);
     }
diff --git a/src/runtime/engine/model_instance.cpp b/src/runtime/engine/model_instance.cpp
index 05eb4916..f7419b22 100644
--- a/src/runtime/engine/model_instance.cpp
+++ b/src/runtime/engine/model_instance.cpp
@@ -364,6 +364,16 @@ EngineOptions normalize_engine_options(EngineOptions options) {
                 "and disabled prefix cache");
         }
     }
+    if (options.purpose == EnginePurpose::Generation && options.kvmem.selected_tokens != 0 &&
+        static_cast<std::uint64_t>(options.kvmem.selected_tokens) >
+            4ULL * options.kvmem.reserve_tokens) {
+        publish_diagnostic(options.diagnostic_observer, DiagnosticLevel::Warning,
+            "KVMem B/R is %.2f (> 4): the 80%% reselect high-water is in the thrash regime; "
+            "set --kvmem-gen-reserve to at least %u to avoid repeated reselections",
+            static_cast<double>(options.kvmem.selected_tokens) /
+                static_cast<double>(options.kvmem.reserve_tokens),
+            options.kvmem.selected_tokens / 4 + 1);
+    }
     switch (options.purpose) {
     case EnginePurpose::Generation:
         break;
-- 
