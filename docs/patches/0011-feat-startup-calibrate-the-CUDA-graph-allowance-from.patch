From 815302a5a4a51c8e0feb71e75337151b79929db4 Mon Sep 17 00:00:00 2001
From: kvmem <kvmem@local>
Date: Sun, 25 Oct 2026 13:05:40 +0800
Subject: [PATCH] feat(startup): calibrate the CUDA graph allowance from a
 minimal KV probe

The topology formula covers every driver shape, so it over-reserves long DFlash2 windows by roughly 700 MiB. Build a probe Program with the full logical window but only the physical pages that window needs, read its measured graph footprint, and use max(measured, 256 MiB) for the final capacity plan. A failed probe keeps the static allowance; --no-cuda-graph returns without probing; an explicit --cuda-graph-allowance-mib still wins.
---
 .../qwen3_5/program/planning/startup.cpp      | 20 +++++++++++++
 src/models/qwen3_5/program/planning/startup.h |  6 ++++
 src/models/qwen3_5/program/program.cpp        | 28 +++++++++++++++++++
 src/models/qwen3_5/program/program.h          |  9 ++++++
 src/runtime/engine/model_instance.cpp         | 19 ++++++++++++-
 5 files changed, 81 insertions(+), 1 deletion(-)

diff --git a/src/models/qwen3_5/program/planning/startup.cpp b/src/models/qwen3_5/program/planning/startup.cpp
index f3d70f92..144c9a9c 100644
--- a/src/models/qwen3_5/program/planning/startup.cpp
+++ b/src/models/qwen3_5/program/planning/startup.cpp
@@ -1483,6 +1483,26 @@ make_sequence_planner_impl(const execution::Parameters& parameters, DeviceContex
     return planner;
 }
 
+std::unique_ptr<SequencePlanImpl>
+make_graph_probe_plan(const execution::Parameters& parameters, DeviceContext& device,
+                      const EngineOptions& options, std::uint32_t main_page_groups) {
+    auto planner = make_sequence_planner_impl(parameters, device, options, 0);
+    auto inputs  = planner->inputs;
+    // A KVMem window is the capacity the masked-draft graph profiles are built from; using it as
+    // the probe's logical capacity keeps every profile while avoiding a full max-context KV pool.
+    const bool windowed = (inputs.speculative_backend == SpeculativeBackend::DFlash ||
+                           inputs.speculative_backend == SpeculativeBackend::DFlash2) &&
+                          inputs.kvmem_window_tokens != 0 &&
+                          inputs.kvmem_window_tokens < inputs.capacity;
+    if (windowed) inputs.capacity = inputs.kvmem_window_tokens;
+    const auto pages = std::max(page_count(inputs.capacity), main_page_groups);
+    if (pages == 0) { throw std::invalid_argument("CUDA graph probe needs a physical KV page"); }
+    // Keep the planner's logical capacity so every graph profile is captured, but allocate only
+    // the pages that capacity needs. The capacity-curve minimum deliberately does not apply: this
+    // plan is never served.
+    return build_sequence_candidate(inputs, pages);
+}
+
 std::unique_ptr<SequencePlanImpl>
 finalize_sequence_plan_impl(std::unique_ptr<qwen3_5::detail::SequencePlannerImpl> planner,
                             std::uint32_t main_page_groups) {
