+++ b/src/ops/linear/sm70/sm70_project.cu
@@ -0,0 +1,209 @@
+#include "ops/linear/sm70/sm70_project.h"
+
+#include "core/device.h"
+#include "core/layout.h"
+#include "ops/common/math.cuh"
+#include "ops/linear/sm70/sm70_dequantize.h"
+#include "ops/linear/sm70/sm70_epilogue.cuh"
+#include "ops/linear/sm70/sm70_gemm.cuh"
+#include "ops/linear/sm70/sm70_integer.h"
+#include "ops/linear/sm70/sm70_small.h"
+
+#include <algorithm>
+#include <stdexcept>
+
+namespace ninfer::ops::detail::sm70 {
+namespace {
+
+// plane [t][2 * count]: gate rows then up rows of one slab.
+__global__ void swiglu_epilogue_kernel(const float* __restrict__ plane, std::int32_t count,
+                                       std::int32_t tokens, std::int32_t row0, std::int32_t rows,
+                                       RowFactor gate_factor, std::int32_t gate_first,
+                                       RowFactor up_factor, std::int32_t up_first,
+                                       __nv_bfloat16* __restrict__ out) {
+    const std::int32_t r = static_cast<std::int32_t>(blockIdx.x * blockDim.x + threadIdx.x);
+    if (r >= count) { return; }
+    const float gate_scale = gate_factor(gate_first + row0 + r);
+    const float up_scale   = up_factor(up_first + row0 + r);
+    for (std::int32_t t = static_cast<std::int32_t>(blockIdx.y); t < tokens;
+         t += static_cast<std::int32_t>(gridDim.y)) {
+        const float* column = plane + static_cast<std::size_t>(t) * (2 * count);
+        out[static_cast<std::size_t>(t) * rows + row0 + r] =
+            __float2bfloat16_rn(silu(column[r] * gate_scale) * (column[count + r] * up_scale));
+    }
+}
+
+std::int32_t pass_columns(std::int32_t tokens) { return std::min(tokens, kWideColumns); }
+
+// body(x16, first, count) for each pass over the call's columns: one over the FP16 plane prepare()
+// converted, or one per kWideColumns columns converted here.
+template <class Body>
+void by_pass(const Activation& x, cudaStream_t stream, Body&& body) {
+    if (x.data != nullptr) {
+        body(x.data, 0, x.tokens);
+        return;
+    }
+    for (std::int32_t first = 0; first < x.tokens; first += kWideColumns) {
+        const std::int32_t count = std::min(kWideColumns, x.tokens - first);
+        convert_activation(x.bf16 + static_cast<std::size_t>(first) * x.k, x.k, count, x.pass,
+                           stream);
+        body(x.pass, first, count);
+    }
+}
+
+} // namespace
+
+std::size_t workspace_bytes(std::int32_t max_rows, std::int32_t k, std::int32_t tokens) {
+    WorkspaceLayoutBuilder layout;
+    (void)layout.alloc_bytes(activation_bytes(k, pass_columns(tokens)));
+    (void)layout.alloc_bytes(slab_bytes(max_rows, k, pass_columns(tokens)));
+    return layout.peak_bytes(1);
+}
+
+Activation prepare(const Tensor& x, std::int32_t max_rows, WorkspaceArena& workspace,
+                   cudaStream_t stream) {
+    if (x.dtype != DType::BF16 || x.data == nullptr || !x.is_contiguous() || x.ne[2] != 1 ||
+        x.ne[3] != 1 || max_rows <= 0) {
+        throw std::invalid_argument("sm70 projection: x must be a contiguous BF16 [K, T]");
+    }
+    Activation out;
+    out.k                     = x.ne[0];
+    out.tokens                = x.ne[1];
+    out.max_rows              = max_rows;
+    const std::int32_t columns = pass_columns(out.tokens);
+    auto* f16 = static_cast<__half*>(workspace.alloc_bytes(activation_bytes(out.k, columns)).data);
+    out.scratch = workspace.alloc_bytes(slab_bytes(max_rows, out.k, columns)).data;
+    const auto* bf16 = static_cast<const __nv_bfloat16*>(x.data);
+    if (columns == out.tokens) {
+        convert_activation(bf16, out.k, out.tokens, f16, stream);
+        out.data = f16;
+    } else {
+        out.bf16 = bf16;
+        out.pass = f16;
+    }
+    return out;
+}
+
+void project(const Activation& x, const Weight& w, std::span<const Destination> destinations,
+             cudaStream_t stream) {
+    if (w.k != x.k || w.n > x.max_rows || destinations.empty() ||
+        destinations.size() > kMaxDestinations || !dequantizable(w)) {
+        throw std::invalid_argument("sm70 projection: unsupported weight or destinations");
+    }
+    const auto dequantize = [&](std::int32_t row0, std::int32_t count, __half* dst) {
+        dequantize_rows(w, row0, count, dst, stream);
+    };
+    by_pass(x, stream, [&](const __half* x16, std::int32_t first, std::int32_t columns) {
+        DestinationEpilogue epilogue;
+        for (Destination d : destinations) {
+            d.data += static_cast<std::size_t>(first) * d.leading;
+            epilogue.set[epilogue.count++] = d;
+        }
+        epilogue.factor = row_factor(w);
+        product(x16, columns, w.n, w.k, dequantize, epilogue, x.scratch, stream);
+    });
+}
+
+void swiglu(const Activation& x, const Weight& gate, const Weight* up, Tensor& out,
+            cudaStream_t stream) {
+    const std::int32_t rows = out.ne[0];
+    const bool joined       = up == nullptr;
+    if (out.dtype != DType::BF16 || out.ne[1] != x.tokens || gate.k != x.k ||
+        (joined ? gate.n != 2 * rows : (gate.n != rows || up->n != rows || up->k != x.k)) ||
+        !dequantizable(gate) || (!joined && !dequantizable(*up))) {
+        throw std::invalid_argument("sm70 swiglu: unsupported weights or output");
+    }
+    const std::int32_t slab = std::max(1, slab_rows(x.max_rows, x.k) / 2);
+    auto* weights           = static_cast<__half*>(x.scratch);
+    auto* plane             = reinterpret_cast<float*>(
+        static_cast<std::byte*>(x.scratch) +
+        (static_cast<std::size_t>(slab_rows(x.max_rows, x.k)) * x.k * sizeof(__half) + 255) / 256 *
+            256);
+    const Weight& up_weight     = joined ? gate : *up;
+    const std::int32_t up_first = joined ? rows : 0;
+    constexpr int kThreads      = 256;
+    by_pass(x, stream, [&](const __half* x16, std::int32_t first, std::int32_t columns) {
+        auto* destination =
+            static_cast<__nv_bfloat16*>(out.data) + static_cast<std::size_t>(first) * rows;
+        for (std::int32_t row0 = 0; row0 < rows; row0 += slab) {
+            const std::int32_t count = std::min(slab, rows - row0);
+            dequantize_rows(gate, row0, count, weights, stream);
+            dequantize_rows(up_weight, up_first + row0, count,
+                            weights + static_cast<std::size_t>(count) * x.k, stream);
+            gemm(weights, 2 * count, x.k, x16, columns, plane, 2 * count, stream);
+            const dim3 grid(static_cast<unsigned>((count + kThreads - 1) / kThreads),
+                            static_cast<unsigned>(std::min<std::int32_t>(columns, 65535)));
+            swiglu_epilogue_kernel<<<grid, kThreads, 0, stream>>>(
+                plane, count, columns, row0, rows, row_factor(gate), 0, row_factor(up_weight),
+                up_first, destination);
+            CUDA_CHECK(cudaGetLastError());
+        }
+    });
+}
+
+bool covered_format(QType format, std::int32_t k) {
+    // The small-T route's chunks: one T2 G128 group, 64 values of the other formats.
+    const std::int32_t chunk = format == QType::T2_G128_FP16 ? 128 : 64;
+    return dequantizable_format(format) && k % chunk == 0;
+}
+
+bool covers(const Weight& w, std::int32_t tokens) {
+    return enabled() && tokens >= 1 && covered_format(w.qtype, w.k) && dequantizable(w);
+}
+
+std::size_t covered_bytes(QType format, std::int32_t max_rows, std::int32_t k,
+                          std::int32_t min_tokens, std::int32_t max_tokens, LinearPolicy policy) {
+    std::size_t bytes = 0;
+    if (small_takes(min_tokens)) {
+        bytes = small_workspace_bytes(k, std::min(max_tokens, cublas_min_tokens() - 1));
+    }
+    if (integer_format(format, k, min_tokens, policy)) {
+        bytes = std::max(bytes, integer_bytes(k, std::min(max_tokens, kIntegerMaxTokens)));
+    }
+    if (takes(max_tokens)) { bytes = std::max(bytes, workspace_bytes(max_rows, k, max_tokens)); }
+    return bytes;
+}
+
+Activation prepare_for(const Tensor& x, std::int32_t max_rows, WorkspaceArena& workspace,
+                       cudaStream_t stream, bool integer) {
+    if (takes(x.ne[1])) { return prepare(x, max_rows, workspace, stream); }
+    Activation out = small_prepare(x, workspace, stream);
+    if (integer) { integer_prepare(x, workspace, stream, out); }
+    return out;
+}
+
+bool direct_tokens(std::int32_t tokens) {
+    return small_takes(tokens) && tokens <= kSmallDirectTokens;
+}
+
+Activation prepare_direct(const Tensor& x) {
+    if (!direct_tokens(x.ne[1])) {
+        throw std::invalid_argument(
+            "sm70 projection: a direct activation is at most eight columns");
+    }
+    return small_direct(x);
+}
+
+void project_for(const Activation& x, const Weight& w, std::span<const Destination> destinations,
+                 cudaStream_t stream) {
+    if (x.codes != nullptr && w.qtype == QType::T2_G128_FP16) {
+        integer_project(x, w, destinations, stream);
+    } else if (takes(x.tokens)) {
+        project(x, w, destinations, stream);
+    } else {
+        small_project(x, w, destinations, stream);
+    }
+}
+
+void swiglu_for(const Activation& x, const Weight& gate, const Weight* up, Tensor& out,
+                cudaStream_t stream) {
+    if (x.codes != nullptr && gate.qtype == QType::T2_G128_FP16) {
+        integer_swiglu(x, gate, up, out, stream);
+    } else if (takes(x.tokens)) {
+        swiglu(x, gate, up, out, stream);
+    } else {
+        small_swiglu(x, gate, up, out, stream);
+    }
+}
+
+} // namespace ninfer::ops::detail::sm70
diff --git a/src/ops/linear/sm70/sm70_project.h b/src/ops/linear/sm70/sm70_project.h
new file mode 100644
index 00000000..dc3b15c2
--- /dev/null
+++ b/src/ops/linear/sm70/sm70_project.h
@@ -0,0 +1,116 @@
+#pragma once
+
+// sm_70 wide projections of any dense weight format (sm70_dequantize.h) through the FP16 cuBLAS
+// route of sm70_gemm.h, with the epilogues the fused Linear Ops need: a parent's row ranges stored
+// into or added onto BF16 planes, and SwiGLU over a [gate; up] pair. Callers gate on
+// sm70::takes(tokens) && sm70::dequantizable(weight).
+
+#include "core/arena.h"
+#include "core/tensor.h"
+#include "core/weight.h"
+#include "ninfer/ops/linear.h"
+#include "ops/linear/sm70/sm70_gemm.h"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::ops::detail::sm70 {
+
+// Parent rows [row_begin, row_begin + rows) land at destination rows from row_offset of a BF16
+// plane with `leading` rows per column: stored, or added onto (the residual epilogue).
+struct Destination {
+    __nv_bfloat16* data     = nullptr;
+    std::int32_t leading    = 0;
+    std::int32_t row_offset = 0;
+    std::int32_t row_begin  = 0;
+    std::int32_t rows       = 0;
+    bool accumulate         = false;
+};
+
+inline constexpr int kMaxDestinations = 4;
+
+// The columns a wide call converts and multiplies at once: every prompt chunk in one pass, a
+// Vision item's patches in several, which bounds its FP16 activations and FP32 product plane.
+inline constexpr std::int32_t kWideColumns = 8192;
+
+// The activations of one call in FP16 (or, for the small-T route's direct widths, as the caller's
+// BF16 plane) and the slab scratch every parent of up to `max_rows` rows shares. A wide call of
+// more than kWideColumns columns keeps its BF16 plane and converts each pass's columns into `pass`.
+struct Activation {
+    const __half* data        = nullptr;
+    const __nv_bfloat16* bf16 = nullptr;
+    __half* pass              = nullptr;
+    std::int32_t k            = 0;
+    std::int32_t tokens       = 0;
+    std::int32_t max_rows     = 0;
+    void* scratch             = nullptr;
+    // The integer route's quantized form (sm70_integer.h), when the call takes it.
+    const std::int8_t* codes      = nullptr;
+    const float* code_scales      = nullptr;
+    const std::int32_t* code_sums = nullptr;
+};
+
+// Workspace of prepare() for parents of at most `max_rows` rows.
+[[nodiscard]] std::size_t workspace_bytes(std::int32_t max_rows, std::int32_t k,
+                                          std::int32_t tokens);
+
+[[nodiscard]] Activation prepare(const Tensor& x, std::int32_t max_rows, WorkspaceArena& workspace,
+                                 cudaStream_t stream);
+
+// Every row of `w` into the destination that takes it (at most kMaxDestinations).
+void project(const Activation& x, const Weight& w, std::span<const Destination> destinations,
+             cudaStream_t stream);
+
+// out[i, t] = silu(gate_i . x_t) * (up_i . x_t), with gate rows [0, rows) and up rows [rows,
+// 2 rows) of one parent (`up` null) or rows of two weights. `out` is BF16 [rows, T].
+void swiglu(const Activation& x, const Weight& gate, const Weight* up, Tensor& out,
+            cudaStream_t stream);
+
+// --- Both sm_70 routes ------------------------------------------------------------------------
+// The wide route above and the small-T one (sm70_small.h) together take every width of a dense
+// format on sm_70; the *_for functions pick the one a call's width takes.
+
+// Whether a dense weight of this format and input width has both routes (whole chunks of the
+// small-T route: 128 values for T2, 64 for the other formats).
+[[nodiscard]] bool covered_format(QType format, std::int32_t k);
+[[nodiscard]] bool covers(const Weight& w, std::int32_t tokens);
+
+// Workspace over [min_tokens, max_tokens] for parents of up to `max_rows` rows when the format is
+// covered, the integer route's (sm70_integer.h) included where `policy` admits it; otherwise
+// routes(min_tokens, max_tokens), the Op's own routes.
+template <class Routes>
+[[nodiscard]] std::size_t capacity(QType format, std::int32_t max_rows, std::int32_t k,
+                                   std::int32_t min_tokens, std::int32_t max_tokens,
+                                   LinearPolicy policy, Routes&& routes);
+
+// The activations of a call; `integer` (sm70::integer_takes for the call's weights) adds the
+// integer route's quantized form.
+[[nodiscard]] Activation prepare_for(const Tensor& x, std::int32_t max_rows,
+                                     WorkspaceArena& workspace, cudaStream_t stream,
+                                     bool integer = false);
+// The activations of a call no wider than the small-T route's direct widths, which need no
+// workspace (callers without an arena check direct_tokens first).
+[[nodiscard]] bool direct_tokens(std::int32_t tokens);
+[[nodiscard]] Activation prepare_direct(const Tensor& x);
+void project_for(const Activation& x, const Weight& w, std::span<const Destination> destinations,
+                 cudaStream_t stream);
+void swiglu_for(const Activation& x, const Weight& gate, const Weight* up, Tensor& out,
+                cudaStream_t stream);
+
+[[nodiscard]] std::size_t covered_bytes(QType format, std::int32_t max_rows, std::int32_t k,
+                                        std::int32_t min_tokens, std::int32_t max_tokens,
+                                        LinearPolicy policy);
+
+template <class Routes>
+std::size_t capacity(QType format, std::int32_t max_rows, std::int32_t k, std::int32_t min_tokens,
+                     std::int32_t max_tokens, LinearPolicy policy, Routes&& routes) {
+    if (!enabled() || !covered_format(format, k)) { return routes(min_tokens, max_tokens); }
+    return covered_bytes(format, max_rows, k, min_tokens, max_tokens, policy);
+}
+
+} // namespace ninfer::ops::detail::sm70
diff --git a/src/ops/linear/sm70/sm70_small.cu b/src/ops/linear/sm70/sm70_small.cu
new file mode 100644
index 00000000..a0f30e9b
--- /dev/null
+++ b/src/ops/linear/sm70/sm70_small.cu
@@ -0,0 +1,295 @@
+#include "ops/linear/sm70/sm70_small.h"
+
+#include "core/device.h"
+#include "ops/common/math.cuh"
+#include "ops/linear/sm70/sm70_dequantize.h"
+#include "ops/linear/sm70/sm70_epilogue.cuh"
+#include "ops/linear/sm70/sm70_gemm.h"
+#include "ops/linear/sm70/sm70_small.cuh"
+
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <type_traits>
+
+namespace ninfer::ops::detail::sm70 {
+namespace {
+
+template <class Decoder>
+__host__ __device__ constexpr float value_scale() {
+    if constexpr (requires { Decoder::kValueScale; }) {
+        return Decoder::kValueScale;
+    } else {
+        return 1.0f;
+    }
+}
+
+template <class Decoder, int Tiles, bool Direct, int Warps>
+__launch_bounds__(Warps * 32) __global__
+    void small_project_kernel(Decoder decoder, std::int32_t rows,
+                              const std::uint16_t* __restrict__ x, std::int32_t k,
+                              std::int32_t col0, std::int32_t cols, DestinationEpilogue epilogue) {
+    __shared__ SmallShared<Tiles, Decoder::kChunk, Warps> shared;
+    const std::int32_t row0 = static_cast<std::int32_t>(blockIdx.x) * kSmallTileRows;
+    small_tile<Decoder, Tiles, Direct, Warps>(decoder, decoder, row0, row0, kSmallTileRows, rows,
+                                              rows, x, k, col0, cols, shared);
+    if (threadIdx.x >= 32) { return; }
+    constexpr float kScale = value_scale<Decoder>();
+    for (int e = static_cast<int>(threadIdx.x); e < kSmallTileRows * 8 * Tiles; e += 32) {
+        const int r            = e / (8 * Tiles);
+        const int c            = e % (8 * Tiles);
+        const std::int32_t row = row0 + r;
+        if (row < rows && c < cols) { epilogue(row, col0 + c, shared.partial[0][r][c] * kScale); }
+    }
+}
+
+// Tile rows 0..15 are gate rows [i0, i0 + 16), rows 16..31 the matching up rows.
+template <class Decoder, int Tiles, bool Direct, int Warps>
+__launch_bounds__(Warps * 32) __global__
+    void small_swiglu_kernel(Decoder gate, Decoder up, std::int32_t rows, std::int32_t gate_first,
+                             std::int32_t up_first, std::int32_t gate_limit, std::int32_t up_limit,
+                             const std::uint16_t* __restrict__ x, std::int32_t k, std::int32_t col0,
+                             std::int32_t cols, RowFactor gate_factor, RowFactor up_factor,
+                             __nv_bfloat16* __restrict__ out) {
+    __shared__ SmallShared<Tiles, Decoder::kChunk, Warps> shared;
+    const std::int32_t i0 = static_cast<std::int32_t>(blockIdx.x) * (kSmallTileRows / 2);
+    small_tile<Decoder, Tiles, Direct, Warps>(gate, up, gate_first + i0, up_first + i0,
+                                              kSmallTileRows / 2, gate_limit, up_limit, x, k, col0,
+                                              cols, shared);
+    if (threadIdx.x >= 32) { return; }
+    constexpr float kScale = value_scale<Decoder>();
+    for (int e = static_cast<int>(threadIdx.x); e < (kSmallTileRows / 2) * 8 * Tiles; e += 32) {
+        const int r          = e / (8 * Tiles);
+        const int c          = e % (8 * Tiles);
+        const std::int32_t i = i0 + r;
+        if (i < rows && c < cols) {
+            const float g = shared.partial[0][r][c] * kScale * gate_factor(gate_first + i);
+            const float u =
+                shared.partial[0][r + kSmallTileRows / 2][c] * kScale * up_factor(up_first + i);
+            out[static_cast<std::size_t>(col0 + c) * rows + i] = __float2bfloat16_rn(silu(g) * u);
+        }
+    }
+}
+
+[[maybe_unused]] RowSplitView row_split_view(const Weight& w, int group) {
+    RowSplitView view;
+    view.base           = static_cast<const std::uint8_t*>(w.qdata);
+    view.high           = static_cast<const std::uint8_t*>(w.qhigh);
+    view.scales         = static_cast<const __half*>(w.scales);
+    view.groups_per_row = w.padded_shape[1] / group;
+    view.panel_shift    = row_split_panel_shift(w.layout);
+    return view;
+}
+
+// f.template operator()<Decoder>(decoder) with the weight's decoder.
+template <class F>
+void with_decoder(const Weight& w, F&& f) {
+    switch (w.qtype) {
+    case QType::Q2_G64_FP16:
+        return f(Quartet2Decoder<false>{row_split_view(w, 64)});
+    case QType::Q4_G64_FP16:
+        return f(Q4Decoder{row_split_view(w, 64)});
+    case QType::Q5_G64_FP16:
+        return f(Q5Decoder{row_split_view(w, 64)});
+    case QType::Q6_G64_FP16:
+        return f(Q6Decoder{row_split_view(w, 64)});
+    case QType::Q8_G32_FP16:
+        return f(Q8Decoder{row_split_view(w, 32)});
+    case QType::T2_G128_FP16:
+        return f(Quartet2Decoder<true>{row_split_view(w, 128)});
+    case QType::BF16:
+        return f(Bf16Decoder{static_cast<const __nv_bfloat16*>(w.qdata), w.k});
+    case QType::FP8_E4M3FN_ROW_BF16:
+        return f(Fp8Decoder{static_cast<const std::uint8_t*>(w.qdata), w.k});
+    case QType::NVFP4:
+        return f(Nvfp4Decoder{static_cast<const std::uint8_t*>(w.qdata),
+                              static_cast<const std::uint8_t*>(w.scales), w.k});
+    default:
+        break;
+    }
+    throw std::invalid_argument("sm70 small-T: unsupported weight format");
+}
+
+// Column launches of 8, 16 or 32 columns over [0, tokens): launch<Tiles, Direct>(x, col0, cols),
+// on the caller's BF16 plane at the direct widths and on the prepared P8 FP16 one otherwise.
+template <class Launch>
+void by_columns(const Activation& x, Launch&& launch) {
+    if (x.data == nullptr) {
+        launch.template operator()<1, true>(reinterpret_cast<const std::uint16_t*>(x.bf16), 0,
+                                            x.tokens);
+        return;
+    }
+    const auto* f16 = reinterpret_cast<const std::uint16_t*>(x.data);
+    for (std::int32_t col0 = 0; col0 < x.tokens; col0 += 32) {
+        const std::int32_t cols = std::min<std::int32_t>(32, x.tokens - col0);
+        if (cols <= 8) {
+            launch.template operator()<1, false>(f16, col0, cols);
+        } else if (cols <= 16) {
+            launch.template operator()<2, false>(f16, col0, cols);
+        } else {
+            launch.template operator()<4, false>(f16, col0, cols);
+        }
+    }
+}
+
+// Sixteen warps per CTA where eight would leave fewer than about 32 warps per SM of a V100 (80
+// SMs) and K still gives each of sixteen warps six or more turns: narrow parents such as a 5120-row
+// down projection, whose 160 tiles of 32 rows would otherwise run 16 warps per SM. Up to two column
+// tiles (shared memory).
+constexpr std::int32_t kWideWarpsBelowTiles = 80 * 32 / kSmallWarps;
+constexpr std::int32_t kWideWarpsMinTurns   = 6;
+
+template <class Decoder, int Tiles, class Launch>
+void with_warps(std::int32_t tiles, std::int32_t k, Launch&& launch) {
+    if constexpr (Tiles <= 2) {
+        const std::int32_t turns = k / (Decoder::kChunk * Decoder::kUnroll);
+        if (tiles < kWideWarpsBelowTiles && turns >= kSmallWideWarps * kWideWarpsMinTurns) {
+            launch.template operator()<kSmallWideWarps>();
+            return;
+        }
+    }
+    launch.template operator()<kSmallWarps>();
+}
+
+// Eight values of a BF16 column per thread into the P8 order of sm70_small.cuh, saturated FP16.
+__global__ void convert_activation_p8_kernel(const uint4* __restrict__ x, uint4* __restrict__ out,
+                                             std::int64_t groups) {
+    const std::int64_t i = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= groups) { return; }
+    const uint4 v      = x[i];
+    const unsigned f01 = bf16x2_to_f16x2(v.x);
+    const unsigned f23 = bf16x2_to_f16x2(v.y);
+    const unsigned f45 = bf16x2_to_f16x2(v.z);
+    const unsigned f67 = bf16x2_to_f16x2(v.w);
+    out[i]             = make_uint4(__byte_perm(f01, f45, 0x5410u), __byte_perm(f01, f45, 0x7632u),
+                                    __byte_perm(f23, f67, 0x5410u), __byte_perm(f23, f67, 0x7632u));
+}
+
+} // namespace
+
+bool small_takes(std::int32_t tokens) { return enabled() && tokens >= 1 && !takes(tokens); }
+
+bool small_shape(const Weight& w) {
+    // A T2 chunk is its whole G128 group (Quartet2Decoder<true>).
+    const std::int32_t chunk = w.qtype == QType::T2_G128_FP16 ? 128 : kSmallChunk;
+    return w.k % chunk == 0 && dequantizable(w);
+}
+
+std::size_t small_workspace_bytes(std::int32_t k, std::int32_t tokens) {
+    return tokens <= kSmallDirectTokens ? 0 : activation_bytes(k, tokens);
+}
+
+namespace {
+
+void require_activation(const Tensor& x) {
+    if (x.dtype != DType::BF16 || x.data == nullptr || !x.is_contiguous() || x.ne[2] != 1 ||
+        x.ne[3] != 1 || reinterpret_cast<std::uintptr_t>(x.data) % 16 != 0) {
+        throw std::invalid_argument("sm70 small-T: x must be a contiguous, 16-byte aligned BF16 "
+                                    "[K, T]");
+    }
+}
+
+} // namespace
+
+Activation small_direct(const Tensor& x) {
+    require_activation(x);
+    if (x.ne[1] > kSmallDirectTokens) {
+        throw std::invalid_argument("sm70 small-T: a direct activation is at most eight columns");
+    }
+    Activation out;
+    out.k      = x.ne[0];
+    out.tokens = x.ne[1];
+    out.bf16   = static_cast<const __nv_bfloat16*>(x.data);
+    return out;
+}
+
+Activation small_prepare(const Tensor& x, WorkspaceArena& workspace, cudaStream_t stream) {
+    require_activation(x);
+    if (x.ne[1] <= kSmallDirectTokens) { return small_direct(x); }
+    Activation out;
+    out.k      = x.ne[0];
+    out.tokens = x.ne[1];
+    auto* f16 =
+        static_cast<__half*>(workspace.alloc_bytes(activation_bytes(out.k, out.tokens)).data);
+    // K is a whole number of 64-value chunks (small_shape), so every eight values are one group.
+    const std::int64_t groups = static_cast<std::int64_t>(out.k) * out.tokens / 8;
+    constexpr int kThreads    = 256;
+    convert_activation_p8_kernel<<<static_cast<unsigned>((groups + kThreads - 1) / kThreads),
+                                   kThreads, 0, stream>>>(static_cast<const uint4*>(x.data),
+                                                          reinterpret_cast<uint4*>(f16), groups);
+    CUDA_CHECK(cudaGetLastError());
+    out.data = f16;
+    return out;
+}
+
+void small_project(const Activation& x, const Weight& w, std::span<const Destination> destinations,
+                   cudaStream_t stream) {
+    if (w.k != x.k || !small_shape(w) || destinations.empty() ||
+        destinations.size() > kMaxDestinations) {
+        throw std::invalid_argument("sm70 small-T: unsupported weight or destinations");
+    }
+#if defined(NINFER_SM70)
+    DestinationEpilogue epilogue;
+    for (const Destination& d : destinations) { epilogue.set[epilogue.count++] = d; }
+    epilogue.factor = row_factor(w);
+    const dim3 grid(static_cast<unsigned>((w.n + kSmallTileRows - 1) / kSmallTileRows));
+    with_decoder(w, [&](auto decoder) {
+        using Decoder = decltype(decoder);
+        by_columns(x, [&]<int Tiles, bool Direct>(const std::uint16_t* plane, std::int32_t col0,
+                                                  std::int32_t cols) {
+            with_warps<Decoder, Tiles>(static_cast<std::int32_t>(grid.x), x.k, [&]<int Warps>() {
+                small_project_kernel<Decoder, Tiles, Direct, Warps>
+                    <<<grid, Warps * 32, 0, stream>>>(decoder, w.n, plane, x.k, col0, cols,
+                                                      epilogue);
+                CUDA_CHECK(cudaGetLastError());
+            });
+        });
+    });
+#else
+    (void)stream;
+    throw std::logic_error("sm70 small-T: this build does not target sm_70");
+#endif
+}
+
+void small_swiglu(const Activation& x, const Weight& gate, const Weight* up, Tensor& out,
+                  cudaStream_t stream) {
+    const std::int32_t rows = out.ne[0];
+    const bool joined       = up == nullptr;
+    const Weight& up_weight = joined ? gate : *up;
+    if (out.dtype != DType::BF16 || out.ne[1] != x.tokens || gate.k != x.k || !small_shape(gate) ||
+        (joined ? gate.n != 2 * rows
+                : (gate.n != rows || up->n != rows || up->k != x.k || up->qtype != gate.qtype ||
+                   !small_shape(*up)))) {
+        throw std::invalid_argument("sm70 small-T swiglu: unsupported weights or output");
+    }
+#if defined(NINFER_SM70)
+    const std::int32_t up_first   = joined ? rows : 0;
+    const std::int32_t gate_limit = joined ? rows : gate.n;
+    const std::int32_t up_limit   = joined ? 2 * rows : up_weight.n;
+    const dim3 grid(static_cast<unsigned>((rows + kSmallTileRows / 2 - 1) / (kSmallTileRows / 2)));
+    with_decoder(gate, [&](auto gate_decoder) {
+        using Decoder = decltype(gate_decoder);
+        with_decoder(up_weight, [&](auto up_decoder) {
+            if constexpr (std::is_same_v<decltype(up_decoder), Decoder>) {
+                by_columns(x, [&]<int Tiles, bool Direct>(const std::uint16_t* plane,
+                                                          std::int32_t col0, std::int32_t cols) {
+                    with_warps<Decoder, Tiles>(
+                        static_cast<std::int32_t>(grid.x), x.k, [&]<int Warps>() {
+                            small_swiglu_kernel<Decoder, Tiles, Direct, Warps>
+                                <<<grid, Warps * 32, 0, stream>>>(
+                                    gate_decoder, up_decoder, rows, 0, up_first, gate_limit,
+                                    up_limit, plane, x.k, col0, cols, row_factor(gate),
+                                    row_factor(up_weight), static_cast<__nv_bfloat16*>(out.data));
+                            CUDA_CHECK(cudaGetLastError());
+                        });
+                });
+            }
+        });
+    });
+#else
+    (void)stream;
+    throw std::logic_error("sm70 small-T: this build does not target sm_70");
+#endif
+}
+
+} // namespace ninfer::ops::detail::sm70
