diff --git a/tools/convert/recipes/dflash2_import_nvfp4.py b/tools/convert/recipes/dflash2_import_nvfp4.py
new file mode 100644
index 00000000..13e3d23f
--- /dev/null
+++ b/tools/convert/recipes/dflash2_import_nvfp4.py
@@ -0,0 +1,35 @@
+"""Import the DFlash2 module's NVFP4 weights verbatim from a ModelOpt source.
+
+Unlike ``dflash2_nvfp4.py`` (which re-quantises a BF16/FP8 companion), this override
+keeps the source's NVFP4 codes, block scales and global divisor. Use it when the
+companion checkpoint is already ModelOpt NVFP4, e.g.
+``maurienne-ai/Qwen3.8-27B-DFlash2-NVFP4-RTNcal``.
+
+The source's ``quantization_config.ignore`` list keeps the feature projection, the
+selector hidden projection and the convolution kernel projections in BF16; those
+parameters are left to the base recipe.
+"""
+from tools.convert.methods import import_encoded
+
+# Parameters the ModelOpt checkpoint keeps outside NVFP4.
+_KEPT_DIRECT = (
+    'dflash2/feature_projection',
+    'dflash2/candidate_selector/hidden_projection',
+)
+
+# The engine's native QKV input projection requires Q8_G32_FP16, so those three
+# projections keep the base recipe's Q8 even though the source ships them as NVFP4.
+_KEPT_Q8 = ('/attention/query', '/attention/key', '/attention/value')
+
+
+def configure(model, recipe, sources):
+    if 'dflash2' not in model.components:
+        raise ValueError('DFlash2 NVFP4 import requires the DFlash2 component')
+    for name, parameter in model.parameters.items():
+        if not name.startswith('dflash2/') or not parameter.projection:
+            continue
+        if name in _KEPT_DIRECT or 'conv' in name or '/attention/context_' in name:
+            continue
+        if any(name.endswith(suffix) for suffix in _KEPT_Q8):
+            continue
+        recipe.assign(name, format='nvfp4', method=import_encoded)
diff --git a/tools/convert/recipes/dflash2_nvfp4.py b/tools/convert/recipes/dflash2_nvfp4.py
new file mode 100644
index 00000000..7b643a6e
--- /dev/null
+++ b/tools/convert/recipes/dflash2_nvfp4.py
@@ -0,0 +1,32 @@
+"""Shipped fork DFlash2 weight-only NVFP4 override for full/QAT recipes.
+
+Pass --components text,dflash2 --source dflash2=CHECKPOINT and
+--override tools/convert/recipes/dflash2_nvfp4.py to tools.convert.
+The 31 parents are five layers' QKV/output/gate-up/down and two convolution
+control projections, plus the selector hidden projection. Feature projection
+remains W8; codebooks, base kernels and norms remain BF16. No A4 divisor is used.
+"""
+from tools.convert.quantization.nvfp4 import nvfp4_maxabs
+
+# The dynamic grouped conv reads the kernel projection as plain BF16; quantising it makes
+# startup fail with "dynamic grouped conv prepare: invalid kernel_projection_weight".
+_KEPT_BF16 = ('/attention_conv/kernel_projection', '/mlp_conv/kernel_projection')
+
+
+def configure(model, recipe, sources):
+    if 'dflash2' not in model.components:
+        raise ValueError('NVFP4 module override requires the DFlash2 component')
+    for name, parameter in model.parameters.items():
+        if not name.startswith('dflash2/') or not parameter.projection:
+            continue
+        if name == 'dflash2/feature_projection' or '/attention/context_' in name:
+            continue
+        if any(name.endswith(suffix) for suffix in _KEPT_BF16):
+            continue
+        recipe.assign(name, format='nvfp4', method=nvfp4_maxabs, activation_policy='A16Only')
+    for layer in range(model.components['dflash2']['config']['num_hidden_layers']):
+        prefix = f'dflash2/layers/{layer}/'
+        recipe.group(tuple(prefix + 'attention/' + role for role in ('query', 'key', 'value')))
+        recipe.group((prefix + 'mlp/gate', prefix + 'mlp/up'))
+        for role in ('key', 'value'):
+            recipe.share(prefix + 'attention/context_' + role, prefix + 'attention/' + role)
