// Generated by cmake/NinferBundles.cmake. Runs one program of the @NINFER_BUNDLE_NAME@ bundle.

#include <cstdio>
#include <cstring>
#include <exception>

@NINFER_BUNDLE_DECLARATIONS@
namespace {

struct Program {
    const char* name;
    int (*entry)(int, char**);
};

const Program programs[] = {
@NINFER_BUNDLE_ENTRIES@};

void list_programs(std::FILE* out) {
    for (const Program& program : programs) { std::fprintf(out, "%s\n", program.name); }
}

const Program* find_program(const char* name) {
    for (const Program& program : programs) {
        if (std::strcmp(name, program.name) == 0) { return &program; }
    }
    return nullptr;
}

// An exception that escapes a program fails it with its message through an ordinary exit rather
// than std::terminate: CTest judges an exited process by its output (a test that found no usable
// CUDA device is skipped, tests/CMakeLists.txt), an aborted one not at all.
int run(const Program& program, int argc, char** argv) {
    try {
        return program.entry(argc, argv);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s: uncaught exception: %s\n", program.name, error.what());
    } catch (...) {
        std::fprintf(stderr, "%s: uncaught exception of an unknown type\n", program.name);
    }
    return 1;
}

} // namespace

int main(int argc, char** argv) {
    // Started under a program's own name (a symlink to the bundle): run it with argv unchanged.
    const char* invoked = argc > 0 ? argv[0] : "";
    for (const char* cursor = invoked; *cursor != '\0'; ++cursor) {
        if (*cursor == '/' || *cursor == '\\') { invoked = cursor + 1; }
    }
    if (const Program* program = find_program(invoked)) { return run(*program, argc, argv); }

    if (argc < 2 || std::strcmp(argv[1], "--list") == 0) {
        std::FILE* out = argc < 2 ? stderr : stdout;
        if (argc < 2) { std::fprintf(out, "usage: @NINFER_BUNDLE_NAME@ <program> [args...]\n\n"); }
        list_programs(out);
        return argc < 2 ? 2 : 0;
    }
    if (const Program* program = find_program(argv[1])) { return run(*program, argc - 1, argv + 1); }
    std::fprintf(stderr, "@NINFER_BUNDLE_NAME@: unknown program '%s'; --list shows them\n", argv[1]);
    return 2;
}
