# Keep the configured SASS images and host code; remove PTX before the host linker reads the archive.
cmake_minimum_required(VERSION 3.28)
if(NOT EXISTS "${ARCHIVE}" OR NOT ARCHITECTURES OR NOT NVPRUNE)
  message(FATAL_ERROR "PTX pruning requires an archive, nvprune and explicit architectures")
endif()
set(arguments)
foreach(arch IN LISTS ARCHITECTURES)
  if(NOT arch MATCHES "^(70|75|80|86|89|120a)$")
    message(FATAL_ERROR "Cannot preserve unsupported CUDA architecture: ${arch}")
  endif()
  list(APPEND arguments "--generate-code=arch=compute_${arch},code=sm_${arch}")
endforeach()
file(SIZE "${ARCHIVE}" before)
set(output "${ARCHIVE}.pruned")
execute_process(COMMAND "${NVPRUNE}" ${arguments} -o "${output}" "${ARCHIVE}"
  RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
  file(REMOVE "${output}")
  message(FATAL_ERROR "nvprune failed for ${ARCHIVE}: ${result}")
endif()
if(NOT EXISTS "${output}")
  message(FATAL_ERROR "nvprune produced no archive: ${ARCHIVE}")
endif()
file(SIZE "${output}" after)
if(after EQUAL 0)
  file(REMOVE "${output}")
  message(FATAL_ERROR "nvprune produced an empty archive: ${ARCHIVE}")
endif()
file(RENAME "${output}" "${ARCHIVE}")
message(STATUS "CUDA archive without PTX: ${ARCHIVE}: ${before} -> ${after} bytes; SASS ${ARCHITECTURES}")
