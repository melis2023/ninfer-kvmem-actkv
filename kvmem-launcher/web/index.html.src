<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>KVMem·NINFER 启动台</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script>
/* 主题引导：必须在样式应用前执行，避免刷新时先闪一下其它主题。
   默认亮色（白色 UI）；一旦用户手动切换过，就以本地保存的选择为准。 */
(function () {
  try {
    var saved = localStorage.getItem("kvmem-launcher-theme");
    var theme = (saved === "light" || saved === "dark") ? saved : "light";
    document.documentElement.setAttribute("data-theme", theme);
  } catch (e) {
    document.documentElement.setAttribute("data-theme", "light");
  }
})();
</script>
<style>
/* ============================================================
   主题变量 —— 亮色（白色）为默认；<html data-theme="dark"> 切换为暗色。
   所有颜色都走变量，切换主题无需改任何选择器。
   把亮色放在 :root 上，即使 JS 被禁用也仍是白色界面。
   ============================================================ */
:root{
  color-scheme:light;
  --bg:#f2f5fa; --bg2:#e9eef6;
  --panel:#ffffff; --panel2:#ffffff; --inset:#f6f8fc;
  --line:rgba(24,52,92,.12); --line2:rgba(24,52,92,.22);
  --txt:#16202e; --dim:#4c5c72; --faint:#7d8ca0;
  --cyan:#0b93c9; --amber:#c4791a; --green:#12975a; --red:#d4384b; --violet:#7250d8;
  --disp:"Rajdhani","Microsoft YaHei","Segoe UI",sans-serif;
  --mono:"JetBrains Mono","Consolas","Microsoft YaHei",monospace;

  --bg-glow:rgba(11,147,201,.09);
  --bg-grid:rgba(24,52,92,.035);
  --scroll:rgba(24,52,92,.22);
  --head-a:rgba(255,255,255,.97); --head-b:rgba(255,255,255,.88);

  --off:#b9c4d4; --off-ring:rgba(24,52,92,.06);
  --shadow-panel:0 10px 26px rgba(24,52,92,.10);
  --accent-fade:rgba(11,147,201,.07);

  --btn-a:#ffffff; --btn-b:#eef2f8;
  --btn-p-a:#e2f4fd; --btn-p-b:#d1ecf9;
  --btn-d-a:#fdeaec; --btn-d-b:#fbd8dc;
  --card-a:#ffffff; --card-b:#f8fafd;
  --shadow-card:0 8px 18px rgba(24,52,92,.10);
  --track:#dde4ee; --knob:#8e9cb0;
  --focus-ring:rgba(11,147,201,.14);
  --bd-cy:rgba(11,147,201,.45); --bd-cy2:rgba(11,147,201,.38);
  --bd-cy3:rgba(11,147,201,.6); --bd-ok:rgba(18,151,90,.35);
  --bd-bad:rgba(212,56,75,.35); --sw-on:rgba(11,147,201,.18);
  --sw-on-bd:rgba(11,147,201,.55); --glow-cy:rgba(11,147,201,.14);

  --cmd-fg:#0b6f9c; --val-fg:#16202e; --tval-fg:#14568c;
  --flash-fg:#062a3d; --flash-glow:rgba(11,147,201,.55);
  --hchip-bg:rgba(24,52,92,.05); --hchip-fg:#16202e;
  --tag-v-bg:rgba(114,80,216,.10); --tag-v-bd:rgba(114,80,216,.30); --tag-v-fg:#5b3fc0;
  --tag-cy-fg:#0a7fae; --tag-am-fg:#a5640f;
  --lv-bg:rgba(11,147,201,.10); --lv-bd:rgba(11,147,201,.30); --lv-fg:#0a7fae;
  --lv-am-fg:#a5640f; --lv-gr-fg:#0f7f4c;
  --am-bg:rgba(196,121,26,.10); --am-bd:rgba(196,121,26,.30);
  --gr-bg:rgba(18,151,90,.10); --gr-bd:rgba(18,151,90,.30);
  --toast-bg:#ffffff; --toast-fg:#14568c; --toast-bd:rgba(11,147,201,.5);
  --toast-shadow:0 12px 30px rgba(24,52,92,.18); --toast-bad-fg:#b32636;
}

/* ---------- 暗色主题 ---------- */
[data-theme="dark"]{
  color-scheme:dark;
  --bg:#05070b; --bg2:#070a10;
  --panel:#0b0f16; --panel2:#0d121c; --inset:#080c13;
  --line:rgba(125,180,255,.10); --line2:rgba(125,180,255,.20);
  --txt:#d7e3f4; --dim:#8fa2bd; --faint:#5b6d89;
  --cyan:#3fd8ff; --amber:#ffb454; --green:#3ee089; --red:#ff5d6c; --violet:#9d7bff;

  --bg-glow:rgba(63,216,255,.07);
  --bg-grid:rgba(125,180,255,.028);
  --scroll:rgba(125,180,255,.18);
  --head-a:rgba(7,10,16,.96); --head-b:rgba(7,10,16,.86);

  --off:#44506a; --off-ring:rgba(125,180,255,.06);
  --shadow-panel:0 10px 30px rgba(0,0,0,.35);
  --accent-fade:rgba(63,216,255,.05);

  --btn-a:#111a2a; --btn-b:#0c1220;
  --btn-p-a:#0e2c40; --btn-p-b:#0a2033;
  --btn-d-a:#3a1220; --btn-d-b:#280d18;
  --card-a:#0d1320; --card-b:#0a0f18;
  --shadow-card:0 8px 20px rgba(0,0,0,.35);
  --track:#141c2b; --knob:#5c6f88;
  --focus-ring:rgba(63,216,255,.10);
  --bd-cy:rgba(63,216,255,.5); --bd-cy2:rgba(63,216,255,.45);
  --bd-cy3:rgba(63,216,255,.7); --bd-ok:rgba(62,224,137,.45);
  --bd-bad:rgba(255,93,108,.5); --sw-on:rgba(63,216,255,.22);
  --sw-on-bd:rgba(63,216,255,.65); --glow-cy:rgba(63,216,255,.12);

  --cmd-fg:#9fd8ff; --val-fg:#dfeaff; --tval-fg:#bfe4ff;
  --flash-fg:#ffffff; --flash-glow:rgba(63,216,255,.9);
  --hchip-bg:rgba(125,180,255,.06); --hchip-fg:#dfeaff;
  --tag-v-bg:rgba(157,123,251,.12); --tag-v-bd:rgba(157,123,251,.35); --tag-v-fg:#b8a1ff;
  --tag-cy-fg:#7fd9ff; --tag-am-fg:#ffcf8f;
  --lv-bg:rgba(63,216,255,.08); --lv-bd:rgba(63,216,255,.30); --lv-fg:#8fdcff;
  --lv-am-fg:#ffcf8f; --lv-gr-fg:#7fe9b0;
  --am-bg:rgba(255,180,84,.10); --am-bd:rgba(255,180,84,.35);
  --gr-bg:rgba(62,224,137,.08); --gr-bd:rgba(62,224,137,.35);
  --toast-bg:#101b2e; --toast-fg:#bfe4ff; --toast-bd:rgba(63,216,255,.55);
  --toast-shadow:0 12px 34px rgba(0,0,0,.5); --toast-bad-fg:#ffb9c1;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:var(--bg); color:var(--txt);
  font-family:var(--disp); font-size:14px;
  background-image:
    radial-gradient(1100px 500px at 50% -180px, var(--bg-glow), transparent 60%),
    repeating-linear-gradient(0deg, transparent 0 39px, var(--bg-grid) 39px 40px),
    repeating-linear-gradient(90deg, transparent 0 39px, var(--bg-grid) 39px 40px);
  transition:background-color .35s, color .35s;
}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--scroll);border-radius:6px}
::-webkit-scrollbar-track{background:transparent}

/* ---------- header ---------- */
header{
  position:sticky;top:0;z-index:50;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:12px 22px;
  background:linear-gradient(180deg, var(--head-a), var(--head-b));
  border-bottom:1px solid var(--line2);
  backdrop-filter:blur(6px);
  transition:background .35s, border-color .35s;
}
.brand{display:flex;align-items:center;gap:14px;min-width:0}
.led{
  width:12px;height:12px;border-radius:50%;flex:none;
  background:var(--off); box-shadow:0 0 0 3px var(--off-ring);
  transition:background .4s, box-shadow .4s;
}
.led.ok{background:var(--green);box-shadow:0 0 12px rgba(62,224,137,.8),0 0 0 3px rgba(62,224,137,.15);animation:pulse 2s infinite}
.led.busy{background:var(--amber);box-shadow:0 0 12px rgba(255,180,84,.8),0 0 0 3px rgba(255,180,84,.15);animation:pulse 1s infinite}
.led.err{background:var(--red);box-shadow:0 0 12px rgba(255,93,108,.8),0 0 0 3px rgba(255,93,108,.15)}
.led.off{background:var(--off)}
@keyframes pulse{50%{opacity:.55}}
.t1{font-size:19px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
.t1 .sep{color:var(--cyan);margin:0 6px}
.t2{font-size:11px;color:var(--faint);letter-spacing:.22em;margin-top:1px}
.chips{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.chip{
  display:flex;align-items:center;gap:7px;
  border:1px solid var(--line);border-radius:7px;
  background:var(--inset);padding:6px 11px;
  font-family:var(--mono);font-size:12px;color:var(--dim);
  transition:border-color .25s;
}
.chip:hover{border-color:var(--line2)}
.chip b{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--txt)}
.chip.c-decode b{color:var(--cyan)} .chip.c-prefill b{color:var(--amber)} .chip.c-mtp b{color:var(--green)}
.chip .tag{font-size:10px;letter-spacing:.14em;color:var(--faint)}

/* ---------- layout ---------- */
main{max-width:1560px;margin:0 auto;padding:20px 22px 8px;display:flex;flex-direction:column;gap:16px}
.row3{display:grid;grid-template-columns:330px 1fr 330px;gap:16px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media (max-width:1250px){ .row3{grid-template-columns:1fr 1fr} .row3 #p1{grid-column:1/-1} .row2{grid-template-columns:1fr} }
@media (max-width:820px){ .row3{grid-template-columns:1fr} header{flex-direction:column;align-items:flex-start} .chips{justify-content:flex-start} }

/* ---------- panel ---------- */
.panel{
  position:relative;
  background:linear-gradient(180deg, var(--panel2), var(--panel));
  border:1px solid var(--line);border-radius:10px;
  box-shadow:var(--shadow-panel);
  opacity:0;transform:translateY(10px);
  animation:rise .5s cubic-bezier(.2,.7,.3,1) forwards;
  transition:background .35s, border-color .35s, box-shadow .35s;
}
.panel:nth-of-type(1){animation-delay:.03s}.panel:nth-of-type(2){animation-delay:.09s}.panel:nth-of-type(3){animation-delay:.15s}
@keyframes rise{to{opacity:1;transform:none}}
.panel::before{
  content:"";position:absolute;top:0;left:14px;right:14px;height:2px;border-radius:2px;
  background:linear-gradient(90deg, var(--cyan), var(--accent-fade) 55%, transparent);
  opacity:.65;
}
.ph{
  display:flex;align-items:baseline;gap:10px;
  padding:13px 16px 11px;border-bottom:1px solid var(--line);
}
.pno{font-family:var(--mono);font-size:11px;color:var(--cyan);letter-spacing:.2em}
.pt{font-size:15px;font-weight:700;letter-spacing:.1em}
.psub{margin-left:auto;font-family:var(--mono);font-size:10px;color:var(--faint);letter-spacing:.12em;text-align:right}
.pbody{padding:14px 16px 16px}

/* ---------- buttons ---------- */
.btn{
  font-family:var(--disp);font-size:14px;font-weight:700;letter-spacing:.08em;
  border:1px solid var(--line2);border-radius:8px;
  background:linear-gradient(180deg,var(--btn-a),var(--btn-b));
  color:var(--txt);padding:10px 14px;cursor:pointer;
  transition:transform .15s, border-color .2s, box-shadow .2s, opacity .2s, background .35s;
}
.btn:hover:not(:disabled){transform:translateY(-1px);border-color:var(--cyan);box-shadow:0 6px 18px var(--glow-cy)}
.btn:active:not(:disabled){transform:translateY(0)}
.btn:disabled{opacity:.38;cursor:not-allowed}
.btn.primary{background:linear-gradient(180deg,var(--btn-p-a),var(--btn-p-b));border-color:var(--bd-cy);color:var(--cyan)}
.btn.danger{background:linear-gradient(180deg,var(--btn-d-a),var(--btn-d-b));border-color:var(--bd-bad);color:var(--red)}
.btn.danger:hover:not(:disabled){border-color:var(--red);box-shadow:0 6px 18px rgba(255,93,108,.14)}
.btn.sm{padding:6px 10px;font-size:12px}
.btnrow{display:flex;gap:10px}
.btnrow .btn{flex:1}

/* ---------- kv table ---------- */
.kv{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px}
.kv td{padding:6px 2px;border-bottom:1px solid var(--line);vertical-align:middle}
.kv td:first-child{color:var(--faint);font-size:11px;letter-spacing:.08em;width:34%}
.kv td:last-child{word-break:break-all}
.kv .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;vertical-align:1px}
.kv .dot.ok{background:var(--green);box-shadow:0 0 8px rgba(62,224,137,.7)}
.kv .dot.bad{background:var(--faint)}
.kv .dot.busy{background:var(--amber)}
.msg{
  min-height:34px;margin:12px 0 4px;padding:9px 12px;border-radius:7px;
  font-family:var(--mono);font-size:12px;line-height:1.5;
  background:var(--inset);border:1px solid var(--line);color:var(--dim);
  transition:border-color .3s,color .3s;
}
.msg.good{border-color:var(--bd-ok);color:var(--green)}
.msg.bad{border-color:var(--bd-bad);color:var(--red)}
.cmdline{
  margin-top:12px;padding:10px 12px;border-radius:7px;
  background:var(--inset);border:1px solid var(--line);
  font-family:var(--mono);font-size:11.5px;line-height:1.7;color:var(--cmd-fg);
  word-break:break-all;white-space:pre-wrap;
}
.cmdline b{color:var(--cyan);font-weight:700}

/* ---------- 参数 Tab 页签 ---------- */
.tabs{
  display:flex;gap:4px;flex-wrap:wrap;
  border-bottom:1px solid var(--line);margin-bottom:12px;
}
.tab{
  font-family:var(--disp);font-size:12.5px;font-weight:700;letter-spacing:.04em;
  padding:7px 12px 8px;border:1px solid transparent;border-bottom:none;
  border-radius:7px 7px 0 0;background:transparent;color:var(--dim);
  cursor:pointer;margin-bottom:-1px;position:relative;
  transition:color .2s, background .2s, border-color .2s;
  white-space:nowrap;
}
.tab:hover{color:var(--cyan);background:var(--inset)}
.tab.on{
  color:var(--cyan);background:var(--inset);
  border-color:var(--line);border-bottom:1px solid var(--inset);
}
.tab.on::after{
  content:"";position:absolute;left:10px;right:10px;top:-1px;height:2px;border-radius:2px;
  background:var(--cyan);
}
.tabpane{display:none}
.tabpane.on{display:block;animation:rise .28s cubic-bezier(.2,.7,.3,1)}
.tabpane .grouph:first-child{margin-top:0}
.opsbar{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);display:flex;gap:10px;flex-wrap:wrap}

/* ---------- form ---------- */
.grouph{
  display:flex;align-items:center;gap:10px;margin:14px 0 8px;
  font-size:11px;font-weight:700;letter-spacing:.22em;color:var(--faint);
}
.grouph:first-child{margin-top:2px}
.grouph::after{content:"";flex:1;height:1px;background:var(--line)}
.frow{display:flex;align-items:center;gap:10px;margin:7px 0}
.frow .fl{width:158px;flex:none;line-height:1.25}
.frow .fl .zh{font-size:13px;color:var(--txt)}
.frow .fl .flag{display:block;font-family:var(--mono);font-size:10px;color:var(--faint);letter-spacing:.04em}
.frow input[type=text],.frow input[type=number]{
  flex:1;min-width:0;
  background:var(--inset);border:1px solid var(--line);border-radius:7px;
  color:var(--txt);font-family:var(--mono);font-size:12px;
  padding:8px 10px;outline:none;transition:border-color .2s, box-shadow .2s;
}
.frow input:focus{border-color:var(--bd-cy3);box-shadow:0 0 0 3px var(--focus-ring)}
.frow input::placeholder{color:var(--faint)}
.frow .wide{flex:1}
/* 下拉菜单（取值受限于服务端支持的枚举） */
.selwrap{position:relative;flex:1;min-width:0;display:flex}
.selwrap::after{
  content:"";position:absolute;right:13px;top:50%;width:6px;height:6px;
  border-right:1.5px solid var(--faint);border-bottom:1.5px solid var(--faint);
  transform:translateY(-70%) rotate(45deg);pointer-events:none;
}
.frow select{
  flex:1;min-width:0;width:100%;appearance:none;-webkit-appearance:none;
  background:var(--inset);border:1px solid var(--line);border-radius:7px;
  color:var(--txt);font-family:var(--mono);font-size:12px;
  padding:8px 32px 8px 10px;outline:none;cursor:pointer;
  transition:border-color .2s, box-shadow .2s, background-color .35s, color .35s;
}
.frow select:hover{border-color:var(--line2)}
.frow select:focus{border-color:var(--bd-cy3);box-shadow:0 0 0 3px var(--focus-ring)}
.frow select option{background:var(--panel);color:var(--txt)}
/* 取值约束提示（跟在 flag 后面） */
.lim{font-style:normal;color:var(--dim);letter-spacing:0}
.frow input:invalid{border-color:var(--bd-bad)}
/* switch */
.sw{position:relative;width:40px;height:20px;flex:none;cursor:pointer}
.sw input{opacity:0;width:0;height:0;position:absolute}
.sw .tr{
  position:absolute;inset:0;border-radius:20px;background:var(--track);border:1px solid var(--line2);
  transition:background .25s,border-color .25s;
}
.sw .tr::after{
  content:"";position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;
  background:var(--knob);transition:transform .25s, background .25s;
}
.sw input:checked + .tr{background:var(--sw-on);border-color:var(--sw-on-bd)}
.sw input:checked + .tr::after{transform:translateX(20px);background:var(--cyan)}
.sw:hover .tr{border-color:var(--cyan)}

/* ---------- presets ---------- */
.plist{display:flex;flex-direction:column;gap:9px}
.pcard{
  position:relative;border:1px solid var(--line);border-radius:9px;
  background:linear-gradient(180deg,var(--card-a),var(--card-b));
  padding:11px 12px 10px;cursor:pointer;
  transition:transform .15s, border-color .2s, box-shadow .2s, background .35s;
}
.pcard:hover{transform:translateY(-1px);border-color:var(--bd-cy2);box-shadow:var(--shadow-card)}
.pcard.active{border-color:var(--bd-cy3);box-shadow:0 0 0 1px rgba(63,216,255,.25), 0 8px 20px var(--glow-cy)}
.pcard .nm{font-size:14px;font-weight:700;letter-spacing:.05em}
.pcard .meta{margin-top:5px;display:flex;gap:6px;flex-wrap:wrap}
.tag{
  font-family:var(--mono);font-size:10px;padding:2px 7px;border-radius:20px;
  background:var(--tag-v-bg);border:1px solid var(--tag-v-bd);color:var(--tag-v-fg);
}
.tag.cy{background:var(--lv-bg);border-color:var(--lv-bd);color:var(--tag-cy-fg)}
.tag.am{background:rgba(255,180,84,.10);border-color:rgba(255,180,84,.35);color:var(--tag-am-fg)}
.pcard .ops{margin-top:9px;display:flex;gap:7px}
.pbadge{
  position:absolute;top:10px;right:12px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;
  color:var(--cyan);
}

/* ---------- metrics ---------- */
/* ---------- 整体布局：顶部横排指标栏 + 下方内容 ---------- */
.shell{
  max-width:1780px;margin:0 auto;padding:16px 20px 8px;
  display:flex;flex-direction:column;gap:16px;
}
.content{display:flex;flex-direction:column;gap:16px;min-width:0}
.rail{display:block}

/* ---------- 指标（顶部横排卡片） ---------- */
/* gap 收紧到 7px，卡片间距更紧凑 */
.mgrid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:7px}
@media (max-width:1500px){ .mgrid{grid-template-columns:repeat(5,minmax(0,1fr))} }
@media (max-width:1000px){ .mgrid{grid-template-columns:repeat(3,minmax(0,1fr))} }
@media (max-width:680px){ .mgrid{grid-template-columns:repeat(2,minmax(0,1fr))} }
.mcard{
  position:relative;border:1px solid var(--line);border-radius:9px;
  background:linear-gradient(180deg,var(--card-a),var(--card-b));
  padding:8px 9px 7px;overflow:hidden;min-width:0;
  transition:border-color .2s, transform .15s, background .35s;
}
.mcard:hover{transform:translateY(-1px);border-color:var(--bd-cy2)}
.mcard .ml{font-size:9.5px;letter-spacing:.08em;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mcard .mv{
  margin-top:3px;font-family:var(--mono);font-size:19px;font-weight:700;line-height:1.1;
  color:var(--val-fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.mcard .mv small{font-size:10px;font-weight:500;color:var(--faint);margin-left:3px}
.mcard .ms{margin-top:2px;font-family:var(--mono);font-size:9px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mcard::after{
  content:"";position:absolute;left:0;right:0;top:0;height:2px;
  background:var(--mc, var(--cyan));opacity:.8;
}
.mcard.flash .mv{animation:flash .6s}
@keyframes flash{0%{text-shadow:0 0 14px var(--flash-glow);color:var(--flash-fg)}100%{text-shadow:none}}
/* 占用率进度条 */
.bar{margin-top:6px;height:4px;border-radius:3px;background:var(--track);overflow:hidden}
.bar i{display:block;height:100%;width:0;border-radius:3px;background:var(--mc,var(--cyan));
  transition:width .5s cubic-bezier(.2,.7,.3,1)}
.bar i.warn{background:var(--amber)}
.bar i.hot{background:var(--red)}
/* 本机资源一行 */
.srow{margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}
.srow .stitle{font-size:10px;letter-spacing:.16em;color:var(--faint);margin-bottom:8px}
/* 资源栏 6 列：CPU / 显存 / 内存 / GPU 状态 / 显卡功耗 / 整机功耗 */
.sgrid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}
@media (max-width:1400px){ .sgrid{grid-template-columns:repeat(3,minmax(0,1fr))} }
@media (max-width:760px){ .sgrid{grid-template-columns:repeat(2,minmax(0,1fr))} }
@media (max-width:480px){ .sgrid{grid-template-columns:1fr} }
/* 估算值标记 */
.est{font-style:normal;font-size:8.5px;color:var(--faint);opacity:.85;margin-left:2px}
.sparkwrap{margin-top:10px;border:1px solid var(--line);border-radius:9px;background:var(--inset);padding:8px 12px 6px}
.sparkwrap .sl{font-size:10.5px;letter-spacing:.14em;color:var(--faint);display:flex;gap:14px}
.sparkwrap .sl i{font-style:normal}
.sparkwrap .sl .c1{color:var(--cyan)}
.sparkwrap .sl .c2{color:var(--amber)}
canvas{display:block;width:100%;height:64px;margin-top:6px}

/* ---------- chat ---------- */
.chatbox{display:flex;gap:10px;align-items:flex-end}
.chatbox textarea{
  flex:1;min-height:64px;resize:vertical;
  background:var(--inset);border:1px solid var(--line);border-radius:8px;
  color:var(--txt);font-family:var(--disp);font-size:13px;padding:9px 11px;outline:none;
  transition:border-color .2s, box-shadow .2s;
}
.chatbox textarea:focus{border-color:var(--bd-cy3);box-shadow:0 0 0 3px var(--focus-ring)}
.optrow{display:flex;gap:10px;margin:10px 0}
.optrow label{font-family:var(--mono);font-size:11px;color:var(--faint);display:flex;align-items:center;gap:7px}
.optrow input{
  width:84px;background:var(--inset);border:1px solid var(--line);border-radius:6px;
  color:var(--txt);font-family:var(--mono);font-size:12px;padding:5px 8px;outline:none;
}
.stream{
  margin-top:10px;min-height:120px;max-height:260px;overflow-y:auto;
  background:var(--inset);border:1px solid var(--line);border-radius:8px;
  padding:10px 12px;font-family:var(--disp);font-size:13.5px;line-height:1.75;white-space:pre-wrap;
}
.stream .cur{display:inline-block;width:8px;height:15px;background:var(--cyan);vertical-align:-2px;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.livetime{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap}
.lv{
  font-family:var(--mono);font-size:11px;padding:4px 10px;border-radius:20px;
  background:var(--lv-bg);border:1px solid var(--lv-bd);color:var(--lv-fg);
}
.lv.am{background:var(--am-bg);border-color:var(--am-bd);color:var(--lv-am-fg)}
.lv.gr{background:var(--gr-bg);border-color:var(--gr-bd);color:var(--lv-gr-fg)}
.timings{margin-top:10px;width:100%;border-collapse:collapse;font-family:var(--mono);font-size:11.5px}
.timings th{
  text-align:left;font-size:10px;letter-spacing:.12em;color:var(--faint);
  padding:5px 8px;border-bottom:1px solid var(--line2);
}
.timings td{padding:5px 8px;border-bottom:1px solid var(--line)}
.timings td:last-child{text-align:right;color:var(--tval-fg)}

/* ---------- log ---------- */
.logctl{display:flex;gap:10px;align-items:center;margin-bottom:10px}
.logctl input[type=text]{
  flex:1;background:var(--inset);border:1px solid var(--line);border-radius:7px;
  color:var(--txt);font-family:var(--mono);font-size:12px;padding:7px 10px;outline:none;
}
.logctl input[type=text]:focus{border-color:var(--bd-cy3)}
.logctl .cnt{font-family:var(--mono);font-size:11px;color:var(--faint)}
.logctl label{font-family:var(--mono);font-size:11px;color:var(--faint);display:flex;gap:6px;align-items:center;cursor:pointer}
.logview{
  height:300px;overflow-y:auto;background:var(--inset);border:1px solid var(--line);
  border-radius:8px;padding:10px 12px;font-family:var(--mono);font-size:11.5px;line-height:1.65;
  white-space:pre-wrap;word-break:break-all;
}
.logview .lt{color:var(--faint);margin-right:9px}

/* ---------- footer / toast / LED ---------- */
footer{
  margin-top:26px;padding:14px 22px 22px;text-align:center;
  font-family:var(--mono);font-size:10.5px;color:var(--faint);letter-spacing:.08em;
  border-top:1px solid var(--line);
}
#toast{
  position:fixed;right:20px;bottom:20px;z-index:99;
  max-width:420px;padding:11px 16px;border-radius:9px;
  background:var(--toast-bg);border:1px solid var(--toast-bd);color:var(--toast-fg);
  font-family:var(--mono);font-size:12px;line-height:1.5;
  box-shadow:var(--toast-shadow);
  opacity:0;transform:translateY(10px);transition:opacity .3s, transform .3s;pointer-events:none;
}
#toast.show{opacity:1;transform:translateY(0)}
#toast.bad{border-color:var(--bd-bad);color:var(--toast-bad-fg)}
.led{
  width:11px;height:11px;border-radius:50%;flex:none;
  background:var(--off);box-shadow:0 0 0 0 rgba(0,0,0,0);
  transition:background .4s;
}
.led.ok{background:var(--green);animation:pulseG 1.8s infinite}
.led.busy{background:var(--amber);animation:pulseA 1.2s infinite}
.led.err{background:var(--red);animation:pulseR 1.2s infinite}
.led.ext{background:var(--cyan);animation:pulseC 1.8s infinite}
@keyframes pulseG{0%{box-shadow:0 0 0 0 rgba(62,224,137,.5)}70%{box-shadow:0 0 0 9px rgba(62,224,137,0)}100%{box-shadow:0 0 0 0 rgba(62,224,137,0)}}
@keyframes pulseA{0%{box-shadow:0 0 0 0 rgba(255,180,84,.5)}70%{box-shadow:0 0 0 9px rgba(255,180,84,0)}100%{box-shadow:0 0 0 0 rgba(255,180,84,0)}}
@keyframes pulseR{0%{box-shadow:0 0 0 0 rgba(255,93,108,.5)}70%{box-shadow:0 0 0 9px rgba(255,93,108,0)}100%{box-shadow:0 0 0 0 rgba(255,93,108,0)}}
@keyframes pulseC{0%{box-shadow:0 0 0 0 rgba(63,216,255,.5)}70%{box-shadow:0 0 0 9px rgba(63,216,255,0)}100%{box-shadow:0 0 0 0 rgba(63,216,255,0)}}

.hchips{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.hchip{
  font-family:var(--mono);font-size:11px;padding:5px 11px;border-radius:20px;
  background:var(--hchip-bg);border:1px solid var(--line);color:var(--dim);
  white-space:nowrap;
}
.hchip b{color:var(--hchip-fg);font-weight:700}
.hchip.cy b{color:var(--cyan)}
.hchip.am b{color:var(--amber)}
.hchip.gr b{color:var(--green)}

/* ---------- 主题切换按钮（右上角） ---------- */
.themebtn{
  display:inline-flex;align-items:center;gap:6px;
  font-family:var(--mono);font-size:11px;padding:5px 11px;border-radius:20px;
  background:var(--hchip-bg);border:1px solid var(--line);color:var(--dim);
  cursor:pointer;white-space:nowrap;
  transition:border-color .2s, color .2s, background .35s, transform .15s;
}
.themebtn:hover{border-color:var(--bd-cy);color:var(--cyan);transform:translateY(-1px)}
.themebtn:active{transform:translateY(0)}
.themebtn .tico{font-size:13px;line-height:1;color:var(--amber)}
.themebtn .ttxt{letter-spacing:.06em}
[data-theme="dark"] .themebtn .tico{color:var(--amber)}

/* staggered load（面板入场延迟；.panel 的基础动画在 panel 一节定义） */
#p4{animation-delay:.02s}
#p1{animation-delay:.08s}#p2{animation-delay:.14s}#p3{animation-delay:.20s}
#p5{animation-delay:.26s}#p6{animation-delay:.32s}
</style>
</head>
<body>

<header>
  <div class="brand">
    <span class="led" id="led"></span>
    <div style="margin-top:2px">
      <div style="font-size:17px;font-weight:700;letter-spacing:.12em">KVMEM<span style="color:var(--cyan)">·</span>NINFER <span style="color:var(--cyan)">启动台</span></div>
      <div style="font-size:10.5px;font-family:var(--mono);color:var(--faint);letter-spacing:.14em">kvmem multi-backend framework · graphical launcher console</div>
    </div>
  </div>
  <div class="hchips">
    <span class="hchip">模型 <b id="hModel">—</b></span>
    <span class="hchip cy">decode <b id="hDec">—</b> t/s</span>
    <span class="hchip am">prefill <b id="hPre">—</b> t/s</span>
    <span class="hchip gr">MTP 接受率 <b id="hMtp">—</b></span>
    <span class="hchip">运行 <b id="hUp">—</b></span>
    <button class="themebtn" id="btnTheme" type="button" title="切换亮色 / 暗色主题（快捷键 T）"
            aria-label="切换主题">
      <span class="tico" id="themeIcon">☾</span><span class="ttxt" id="themeText">暗色</span>
    </button>
  </div>
</header>

<main class="shell">

  <!-- ============ 顶部：实时指标（横排） ============ -->
  <aside class="rail">
    <section class="panel" id="p4">
      <div class="ph"><span class="pno">04</span><span class="pt">实时指标</span><span class="psub">每 2 秒 · /stats + /metrics</span></div>
      <div class="pbody">
        <div class="mgrid">
          <div class="mcard" title="解码速度：/metrics llamacpp:predicted_tokens_seconds（执行时间平均 tok/s）；无此指标时回退 /stats 摊销值" style="--mc:var(--cyan)"><div class="ml">DECODE 速度</div><div class="mv"><span id="vDec">—</span><small>t/s</small></div><div class="ms" id="sDec">—</div></div>
          <div class="mcard" title="Prefill 速度：/metrics llamacpp:prompt_tokens_seconds（执行时间平均 tok/s）；无此指标时回退 /stats 摊销值" style="--mc:var(--amber)"><div class="ml">PREFILL 速度</div><div class="mv"><span id="vPre">—</span><small>t/s</small></div><div class="ms" id="sPre">—</div></div>
          <div class="mcard" style="--mc:var(--green)"><div class="ml">MTP 接受率</div><div class="mv"><span id="vMtp">—</span><small>%</small></div><div class="ms" id="sMtp">—</div></div>
          <div class="mcard" style="--mc:var(--violet)"><div class="ml">MTP 草稿统计</div><div class="mv"><span id="vMtpA">—</span></div><div class="ms" id="sMtpA">—</div></div>
          <div class="mcard" style="--mc:var(--cyan)"><div class="ml">预测 Tokens</div><div class="mv"><span id="vPred">—</span></div><div class="ms" id="sPred">—</div></div>
          <div class="mcard" style="--mc:var(--amber)"><div class="ml">提示 Tokens</div><div class="mv"><span id="vPrompt">—</span></div><div class="ms" id="sPrompt">—</div></div>
          <div class="mcard" style="--mc:var(--green)"><div class="ml">KV 容量</div><div class="mv"><span id="vKv">—</span></div><div class="ms" id="sKv">—</div></div>
          <div class="mcard" style="--mc:var(--violet)"><div class="ml">引擎运行</div><div class="mv"><span id="vUp">—</span></div><div class="ms" id="sUp">—</div></div>
        </div>
        <div class="sparkwrap">
          <div class="sl"><i class="c1">● decode tok/s</i><i class="c2">● prefill tok/s</i><i style="margin-left:auto">最近 150 个采样点</i></div>
          <canvas id="spark"></canvas>
        </div>

        <!-- 本机资源占用：CPU / GPU 显存 / 系统内存 / GPU 状态 -->
        <div class="srow">
          <div class="stitle">本机资源占用 · 每 2 秒</div>
          <div class="sgrid">
            <div class="mcard" style="--mc:var(--cyan)">
              <div class="ml">CPU 占用</div>
              <div class="mv"><span id="vCpu">—</span><small>%</small></div>
              <div class="bar"><i id="bCpu"></i></div>
              <div class="ms" id="sCpu">—</div>
            </div>
            <div class="mcard" style="--mc:var(--violet)">
              <div class="ml">GPU 显存</div>
              <div class="mv"><span id="vVram">—</span><small>%</small></div>
              <div class="bar"><i id="bVram"></i></div>
              <div class="ms" id="sVram">—</div>
            </div>
            <div class="mcard" style="--mc:var(--amber)">
              <div class="ml">系统内存</div>
              <div class="mv"><span id="vRam">—</span><small>%</small></div>
              <div class="bar"><i id="bRam"></i></div>
              <div class="ms" id="sRam">—</div>
            </div>
            <div class="mcard" style="--mc:var(--green)">
              <div class="ml">GPU 状态</div>
              <div class="mv"><span id="vGpu">—</span><small>%</small></div>
              <div class="bar"><i id="bGpu"></i></div>
              <div class="ms" id="sGpu">—</div>
            </div>
            <div class="mcard" style="--mc:var(--amber)">
              <div class="ml">显卡功耗</div>
              <div class="mv"><span id="vGpuW">—</span><small>W</small></div>
              <div class="bar"><i id="bGpuW"></i></div>
              <div class="ms" id="sGpuW">—</div>
            </div>
            <div class="mcard" style="--mc:var(--red)">
              <div class="ml">整机功耗<i class="est">估算</i></div>
              <div class="mv"><span id="vSysW">—</span><small>W</small></div>
              <div class="bar"><i id="bSysW"></i></div>
              <div class="ms" id="sSysW">—</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </aside>

  <!-- ============ 下方：内容 ============ -->
  <div class="content">

    <div class="row3">
      <!-- 01 服务控制 -->
      <section class="panel" id="p1">
        <div class="ph"><span class="pno">01</span><span class="pt">服务控制</span><span class="psub" id="stTitle">ninfer · 127.0.0.1:18200</span></div>
        <div class="pbody">
          <div class="btnrow">
            <button class="btn primary" id="btnStart">▲ 启动服务</button>
            <button class="btn danger" id="btnStop">■ 停止服务</button>
          </div>
          <div class="msg" id="stMsg">尚未连接后端…</div>
          <table class="kv" style="margin-top:10px">
            <tr><td>进程状态</td><td id="kvState">—</td></tr>
            <tr><td>受管 PID</td><td id="kvPid">—</td></tr>
            <tr><td>启动时间</td><td id="kvStart">—</td></tr>
            <tr><td>退出码</td><td id="kvExit">—</td></tr>
            <tr><td>上游健康</td><td id="kvHealth">—</td></tr>
            <tr><td>上游地址</td><td id="kvUp">—</td></tr>
          </table>
          <div class="cmdline" id="kvCmd">—</div>
        </div>
      </section>

      <!-- 02 启动参数（Tab 切换） -->
      <section class="panel" id="p2">
        <div class="ph"><span class="pno">02</span><span class="pt">启动参数</span><span class="psub">25 项 · 与 launcher 字段一一对应</span></div>
        <div class="pbody">
          <div id="formRoot"></div>
          <div class="opsbar">
            <button class="btn sm" id="btnSync">⇪ 同步运行中参数</button>
            <button class="btn sm" id="btnReset">↺ 还原主用预设</button>
          </div>
        </div>
      </section>

      <!-- 03 预设管理 -->
      <section class="panel" id="p3">
        <div class="ph"><span class="pno">03</span><span class="pt">预设管理</span><span class="psub">保存 / 切换 / 删除</span></div>
        <div class="pbody">
          <div class="btnrow" style="margin-bottom:12px">
            <button class="btn sm primary" id="btnSaveActive">保存为当前预设</button>
            <button class="btn sm" id="btnSaveNew">＋ 另存为新预设</button>
          </div>
          <div class="plist" id="presetList"></div>
        </div>
      </section>
    </div>

    <div class="row2">
      <!-- 05 对话测试 -->
      <section class="panel" id="p5">
        <div class="ph"><span class="pno">05</span><span class="pt">对话测试</span><span class="psub">SSE 流式 · 含逐段耗时</span></div>
        <div class="pbody">
          <div class="chatbox">
            <textarea id="chatIn" placeholder="输入测试问题，例如：用一句话解释 speculative decoding…（Enter 发送 · Shift+Enter 换行）"></textarea>
            <button class="btn primary" id="btnChat" style="height:40px">发送</button>
          </div>
          <div class="optrow">
            <label>max_tokens <input id="chatMax" type="number" min="1" value="128"></label>
            <label>temperature <input id="chatTemp" type="number" min="0" step="0.1" value="0.6"></label>
          </div>
          <div class="stream" id="chatOut">（对话输出将显示在这里）</div>
          <div class="livetime" id="chatLive"></div>
          <table class="timings" id="timingsTbl" style="display:none">
            <thead><tr><th>指标</th><th>值</th></tr></thead>
            <tbody id="timingsBody"></tbody>
          </table>
        </div>
      </section>

      <!-- 06 服务日志 -->
      <section class="panel" id="p6">
        <div class="ph"><span class="pno">06</span><span class="pt">服务日志</span><span class="psub">受管进程 stdout · 环形缓冲 8000 行</span></div>
        <div class="pbody">
          <div class="logctl">
            <input id="logFilter" type="text" placeholder="过滤关键词…">
            <label><input id="logAuto" type="checkbox" checked> 跟随</label>
            <span class="cnt" id="logCnt">0 行</span>
          </div>
          <div class="logview" id="logView"></div>
        </div>
      </section>
    </div>

  </div>
</main>

<footer>
  backend 127.0.0.1:18300 · /api/state · /api/config · /api/server/start|stop|log · /api/upstream/{stats,metrics,v1/models,chat}
</footer>

<div id="toast"></div>

<script>
"use strict";
/* =====================================================================
   KVMEM·NINFER 启动台 — 前端逻辑（构建产物源）
   后端: launcher.py  →  http://127.0.0.1:18300
   ---------------------------------------------------------------------
   契约（与 launcher.py 逐字对应）:
     GET  /                    → web/index.html
     GET  /api/state           → {pid,state,exit_code,started_at,cmdline,upstream{host,port,health,model},exe,gpu}
     GET  /api/config          → {launcher_port,upstream,exe,bin_dir,gpu,active,presets[{name,flags}]}
     POST /api/config          → 部分键合并 → {ok:true,config}
     GET  /api/server/log?after=N → {lines:[{t:"HH:MM:SS",line}],next}
     POST /api/server/start    → {ok:true,pid,cmdline} | {ok:false,error} | {ok:false,external:true,error}
     POST /api/server/stop     → {ok:true} | {ok:false,error}
     GET  /api/upstream/<path> → 上游原始透传（/stats /metrics /v1/models …）
     POST /api/upstream/chat   → 上游 /v1/chat/completions（SSE 直通）
   上游 ninfer 契约:
     /stats   嵌套 JSON: throughput_tokens_per_second.{decode,prefill}, tokens.{committed_decode,computed_prefill},
                          uptime_seconds, capacity.{kv_capacity_tokens,max_context,kv_capacity_pages}, requests.*, kvmem.*
     /metrics 文本: llamacpp:* / ninfer:* 计数器；DECODE/PREFILL 速度卡优先取
                    llamacpp:predicted_tokens_seconds / llamacpp:prompt_tokens_seconds（执行时间平均 tok/s），
                    /stats 吞吐为总运行时间摊销值（含空闲），仅作回退
     SSE 分片: "data: {json}\n\n"; timings 键 = cache_n, prompt_n, prompt_ms, prompt_per_token_ms,
               prompt_per_second, predicted_n, predicted_ms, predicted_per_token_ms, predicted_per_second,
               draft_n, draft_n_accepted
   ===================================================================== */

/* ---------- 主题切换 ---------- */
const THEME_KEY = "kvmem-launcher-theme";
function currentTheme() {
  // 默认亮色（白色 UI）；只有显式设为 dark 才是暗色
  return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
}
function applyTheme(theme, persist) {
  const t = theme === "light" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", t);
  const light = t === "light";
  // 图标/文案表示"当前主题"，点击切换到另一种
  const ico = $("themeIcon"), txt = $("themeText");
  if (ico) ico.textContent = light ? "☀" : "☾";
  if (txt) txt.textContent = light ? "亮色" : "暗色";
  const btn = $("btnTheme");
  if (btn) btn.title = "当前：" + (light ? "亮色" : "暗色") + " · 点击切换（快捷键 T）";
  if (persist) { try { localStorage.setItem(THEME_KEY, t); } catch (e) { /* 隐私模式忽略 */ } }
  drawSpark();   // 折线图用固定色绘制在 canvas 上，切主题后重绘
}
function toggleTheme() { applyTheme(currentTheme() === "light" ? "dark" : "light", true); }

/* ---------- 字段模式：与 launcher.py 的 FIELD_ORDER 逐项一致（顺序 / 键名 / 标志 / 类型） ---------- */
const FIELDS = [
  ["model", null, "text"],
  ["port", "--port", "num"],
  ["max_context", "--max-context", "num"],
  ["kvmem_recent_tokens", "--kvmem-recent-tokens", "num"],
  ["prefill_chunk", "--prefill-chunk", "num"],
  ["kvmem_budget", "--kvmem-budget", "num"],
  ["kvmem_gen_reserve", "--kvmem-gen-reserve", "num"],
  ["kvmem_host_mib", "--kvmem-host-mib", "num"],
  ["kvmem_action_lrfu", "--kvmem-action-lrfu", "bool"],
  ["model_id", "--model-id", "text"],
  ["kv_dtype", "--kv-dtype", "text"],
  ["temperature", "--temperature", "num"],
  ["top_p", "--top-p", "num"],
  ["top_k", "--top-k", "num"],
  ["min_p", "--min-p", "num"],
  ["spec", "--spec", "text"],
  ["draft_tokens", "--draft-tokens", "num"],
  ["ngram_draft_tokens", "--ngram-draft-tokens", "num"],
  ["adaptive_mtp", "--adaptive-mtp", "bool"],
  ["vision", "--vision", "bool"],
  ["vision_residency", "--vision-residency", "text"],
  ["vision_max_merged", "--vision-max-merged", "num"],
  ["default_reasoning_effort", "--default-reasoning-effort", "text"],
  ["default_thinking_budget", "--default-thinking-budget", "num"],
  ["extra_args", null, "text"],
/*__ADVANCED__*/
];
const FLAG2KEY = {};
for (const f of FIELDS) { if (f[1]) FLAG2KEY[f[1]] = f[0]; }

/* =====================================================================
   下拉选项（CHOICES）
   ---------------------------------------------------------------------
   取值全部取自 ninfer 服务端源码的**枚举解析函数**，不是猜测：
     --spec                    product/speculative_options.h  parse_speculative_backend
     --kv-dtype                serve/serve_options.cpp        parse_kv_dtype
     --vision-residency        serve/serve_options.cpp        (resident|overlay|cpu)
     --default-reasoning-effort serve/request.h               parse_requested_reasoning_effort
   每项格式: key → { values:[值...], hint:"中文说明", labels:{值:说明} }
   值为 "" 的选项表示「省略该参数」（沿用服务端默认值）。
   ===================================================================== */
const CHOICES = {
  spec: {
    values: ["", "mtp", "dflash", "dflash2"],
    hint: "服务端支持 mtp / dflash / dflash2",
    labels: {
      "": "（省略 · 不启用投机解码）",
      mtp: "mtp · MTP 多 token 预测",
      dflash: "dflash · DFlash 草稿",
      dflash2: "dflash2 · DFlash2 草稿"
    }
  },
  kv_dtype: {
    values: ["", "bf16", "int8", "fp8", "rk8v4", "rk4v4", "rk4v4-e8", "rk2v4-e8", "nvfp4", "k8v4"],
    hint: "服务端支持 9 种 KV 存储格式",
    labels: {
      "": "（省略 · 默认 bf16）",
      bf16: "bf16 · 默认",
      int8: "int8 · Int8Group64",
      fp8: "fp8 · Fp8E4M3Row256",
      rk8v4: "rk8v4 · 旋转 INT8 键 + int4 值",
      rk4v4: "rk4v4 · 4bit Lloyd-Max 键",
      "rk4v4-e8": "rk4v4-e8 · E8 吸附 int4 键",
      "rk2v4-e8": "rk2v4-e8 · E8 根码键",
      nvfp4: "nvfp4 · Nvfp4Group16",
      k8v4: "k8v4 · fp8 键 + nvfp4 值"
    }
  },
  vision_residency: {
    values: ["", "resident", "overlay", "cpu"],
    hint: "需同时勾选「视觉输入」",
    labels: {
      "": "（省略）",
      resident: "resident · 常驻显存",
      overlay: "overlay · 覆盖层",
      cpu: "cpu · 放在 CPU 内存"
    }
  },
  default_reasoning_effort: {
    values: ["", "xhigh", "medium", "low", "none", "minimal", "high", "max"],
    // 注意：CLI 协议层接受 7 个值（parse_requested_reasoning_effort），
    // 但 Qwen3.8-27B 的 chat template 只认 xhigh / medium / low 三档；
    // 其余会被"就近映射"（平局向上取）—— 见 translate.cpp 与 chat_template.cpp。
    hint: "Qwen3.8-27B 模板实际支持 xhigh / medium / low 三档；" +
          "none/minimal/high/max 会被就近映射（见括号内说明）",
    labels: {
      "": "（省略 · 模板默认 xhigh）",
      xhigh: "xhigh · 模板支持（默认）",
      medium: "medium · 模板支持",
      low: "low · 模板支持",
      none: "none · 关闭思考",
      minimal: "minimal → 映射为 low（模板不支持）",
      high: "high → 映射为 xhigh（模板不支持）",
      max: "max → 映射为 xhigh（模板不支持）"
    }
  },
  kv_capacity: {
    values: ["", "auto"],
    hint: "auto = 自动定容；或直接填 token 数（须 ≥ max-context）",
    labels: {
      "": "（省略 · 按预设定容）",
      auto: "auto · 由服务端自动决定"
    }
  }
};

/* 数值字段的合法区间（同样来自服务端校验代码），用于 input 的 min/max/step 与即时校验 */
const NUM_RULES = {
  port:                    { min: 1, max: 65535, step: 1, hint: "[1,65535]" },
  max_context:             { min: 1, step: 1, hint: "≥1" },
  prefill_chunk:           { min: 128, step: 128, hint: "128 的正整数倍" },
  kvmem_recent_tokens:     { min: 64, step: 64, hint: "≥64，64 对齐" },
  kvmem_budget:            { min: 0, step: 64, hint: "64 对齐" },
  kvmem_gen_reserve:       { min: 0, step: 64, hint: "64 对齐" },
  kvmem_host_mib:          { min: 0, step: 1, hint: "MiB" },
  temperature:             { min: 0, max: 2, step: 0.05, hint: "[0,2]" },
  top_p:                   { min: 0, max: 1, step: 0.01, hint: "[0,1]" },
  top_k:                   { min: 0, max: 20, step: 1, hint: "[0,20]" },
  min_p:                   { min: 0, max: 1, step: 0.01, hint: "[0,1]" },
  draft_tokens:            { min: 1, max: 15, step: 1, hint: "[1,15]" },
  ngram_draft_tokens:      { min: 0, max: 63, step: 1, hint: "[0,63]" },
  vision_max_merged:       { min: 64, max: 16384, step: 64, hint: "[64,16384]" },
  default_thinking_budget: { min: 0, step: 1, hint: "≥0" },
  /* ---- 进阶参数区间（同样来自服务端校验代码）---- */
  max_concurrency:         { min: 1, max: 8, step: 1, hint: "[1,8]" },
  kvmem_sink_tokens:       { min: 0, step: 64, hint: "64 对齐，0=1 页" },
  kvmem_sessions:          { min: 1, max: 16, step: 1, hint: "1..16" },
  kvmem_lrfu_lambda:       { min: 0, max: 1, step: 0.01, hint: "(0,1)" },
  kvmem_lrfu_top_frac:     { min: 0, max: 1, step: 0.01, hint: "(0,1]" },
  kvmem_conf_budget:       { min: 0, step: 64, hint: "64 对齐，0=关闭" },
  kvmem_conf_scale_up:     { min: 0, step: 0.05, hint: "增长系数" },
  kvmem_conf_cooldown:     { min: 0, step: 1, hint: "压缩轮数" },
  kvmem_conf_pool:         { min: 0, step: 1, hint: "tokens" },
  kvmem_conf_stride:       { min: 0, step: 1, hint: "tokens" },
  kvmem_conf_bottom:       { min: 0, max: 1, step: 0.01, hint: "底部比例" },
  kvmem_disk_mib:          { min: 0, step: 1, hint: "MiB，需配 disk-path" },
  default_max_tokens:      { min: 1, step: 1, hint: "≥1" },
  cuda_graph_allowance_mib:{ min: 0, step: 1, hint: "MiB，需 CUDA 图" },
  rope_yarn_factor:        { min: 1, max: 4, step: 0.01, hint: "[1,4]" },
  rope_scaling_factor:     { min: 1, max: 32, step: 0.01, hint: "[1,32]" }
};

