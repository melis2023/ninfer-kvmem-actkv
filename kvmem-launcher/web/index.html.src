  mlp_a8_decode: "MLP 整数激活解码",
  no_prefill_a8: "Prefill 用 A16 路线",
  lm_head_q4: "LM 头 Q4 量化",
  lm_head_q6: "LM 头 Q6 量化",
  embedding_q4: "Embedding Q4 量化",
  embedding_q6: "Embedding Q6 量化",
  gdn_state_fp16: "GDN 状态 FP16",
  no_cuda_graph: "关闭 CUDA Graphs",
  cuda_graph_allowance_mib: "CUDA 图预留 MiB",
