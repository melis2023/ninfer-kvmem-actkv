  rope_yarn_factor: "YaRN 缩放因子",
  rope_scaling_factor: "线性插值因子"
};

/* ---------- 分组（仅展示，构建期校验每个字段恰好出现一次） ---------- */
const GROUPS = [
  ["模型与端口", ["model", "model_id", "port", "max_context"]],
  ["KVMem 内存", ["kvmem_recent_tokens", "prefill_chunk", "kvmem_budget",
                  "kvmem_gen_reserve", "kvmem_host_mib"]],
  ["actkv", ["kvmem_action_lrfu", "kvmem_lrfu_lambda", "kvmem_lrfu_top_frac"]],
  ["精度与采样", ["kv_dtype", "temperature", "top_p", "top_k", "min_p"]],
  ["MTP 投机解码", ["spec", "draft_tokens", "ngram_draft_tokens", "adaptive_mtp"]],
  ["视觉输入", ["vision", "vision_residency", "vision_max_merged"]],
  ["推理与附加", ["default_reasoning_effort", "default_thinking_budget", "extra_args"]],
  /* ---- 进阶：3 个新页签（第 1 / 2 / 3 梯队）---- */
  ["进阶·KVMem 调优", ["max_concurrency", "kvmem_sink_tokens", "kvmem_sessions",
                       "kvmem_action_region", "kvmem_query_union",
                       "kvmem_conf_budget", "kvmem_conf_scale_up", "kvmem_conf_cooldown",
                       "kvmem_conf_pool", "kvmem_conf_stride", "kvmem_conf_bottom",
                       "kvmem_disk_mib", "kv_capacity", "default_max_tokens",
                       "no_prefix_reuse"]],
  ["进阶·精度与内核", ["fast_prefill_kernel", "prefill_cublas", "mlp_a8_decode",
                       "no_prefill_a8", "lm_head_q4", "lm_head_q6",
                       "embedding_q4", "embedding_q6", "gdn_state_fp16",
                       "no_cuda_graph", "cuda_graph_allowance_mib"]],
  ["进阶·长上下文", ["rope_yarn", "rope_yarn_factor", "rope_scaling_factor"]]
];

/* ---------- 全局状态 ---------- */
let CFG = null;        // /api/config
let STATE = null;      // /api/state
let METRICS = {};      // /metrics 名称 → 数值
let STATS = null;      // /stats 原始对象
let logLines = [];     // {t,line}
let logNext = 0;       // 已消费的索引
let chatBusy = false;
let lastTimings = null;
let spark = { dec: [], pre: [] };
const SPARK_MAX = 150;

/* ---------- 工具 ---------- */
const $ = (id) => document.getElementById(id);
function num(v, d) {
  const x = parseFloat(v);
  return Number.isFinite(x) ? x : d;
}
function fmtInt(v) {
  if (v == null || !Number.isFinite(Number(v))) return "—";
  return Math.round(Number(v)).toLocaleString("en-US");
}
function fmt1(v) {
  if (v == null || !Number.isFinite(Number(v))) return "—";
  return (Math.round(Number(v) * 10) / 10).toString();
}
function fmtDur(s) {
  if (s == null || !Number.isFinite(Number(s))) return "—";
  s = Math.max(0, Math.floor(Number(s)));
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  if (h > 0) return h + "h " + m + "m";
  if (m > 0) return m + "m " + sec + "s";
  return sec + "s";
}
function escapeHtml(s) {
  return String(s == null ? "" : s).replace(/[&<>"']/g, (c) => (
    { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]
  ));
}
function toast(msg, bad) {
  const t = $("toast");
  t.textContent = msg;
  t.className = "show" + (bad ? " bad" : "");
  clearTimeout(t._tm);
  t._tm = setTimeout(() => { t.className = ""; }, 3000);
}
async function jget(url) {
  const r = await fetch(url, { cache: "no-store" });
  if (!r.ok) throw new Error(url + " HTTP " + r.status);
  return r.json();
}
async function jpost(url, body) {
  const r = await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body || {})
  });
  return r.json();
}
async function tget(url) {
  const r = await fetch(url, { cache: "no-store" });
  if (!r.ok) throw new Error(url + " HTTP " + r.status);
  return r.text();
}

/* ---------- 参数 Tab 页签：切换逻辑见 buildForm() ---------- */
function buildForm() {
  const root = $("formRoot");
  root.innerHTML = "";
  const seen = new Set();

  // 每个分组一个 tab；页签栏 + 各页签内容
  const bar = document.createElement("div");
  bar.className = "tabs";
  bar.setAttribute("role", "tablist");
  root.appendChild(bar);

  const panes = [];
  const emit = (key, pane) => {
    const ent = FIELDS.find((f) => f[0] === key);
    if (!ent) return;
    const flag = ent[1], kind = ent[2];
    const choice = CHOICES[key];
    const rule = NUM_RULES[key];
    const row = document.createElement("div");
    row.className = "frow";
    const lab = document.createElement("div");
    lab.className = "fl";
    // flag 后面附带取值约束提示，鼠标悬停显示完整说明
    const lim = rule ? rule.hint : (choice ? "下拉" : "");
    lab.innerHTML = '<span class="zh">' + escapeHtml(ZH[key] || key) + "</span>" +
      '<span class="flag">' + escapeHtml(flag || "位置参数") +
      (lim ? ' <i class="lim">' + escapeHtml(lim) + "</i>" : "") + "</span>";
    if (choice || rule) lab.title = choice ? choice.hint : (ZH[key] + "：" + rule.hint);
    row.appendChild(lab);
    if (kind === "bool") {
      const sw = document.createElement("label");
      sw.className = "sw";
      sw.innerHTML = '<input type="checkbox" id="f_' + key + '"><span class="tr"></span>';
      row.appendChild(sw);
      const cb = sw.querySelector("input");
      cb.addEventListener("change", renderCmd);
    } else if (choice) {
      // 下拉菜单：选项为服务端实际支持的枚举值
      const wrap = document.createElement("div");
      wrap.className = "selwrap";
      const sel = document.createElement("select");
      sel.id = "f_" + key;
      sel.title = choice.hint;
      for (const v of choice.values) {
        const opt = document.createElement("option");
        opt.value = v;
        opt.textContent = (choice.labels && choice.labels[v]) || (v === "" ? "（省略）" : v);
        sel.appendChild(opt);
      }
      sel.addEventListener("change", renderCmd);
      wrap.appendChild(sel);
      row.appendChild(wrap);
    } else {
      const inp = document.createElement("input");
      inp.type = kind === "num" ? "number" : "text";
      inp.id = "f_" + key;
      if (kind === "num") {
        // 数值范围来自服务端校验代码，避免提交会被服务端拒绝的值
        if (rule) {
          if (rule.min != null) inp.min = String(rule.min);
          if (rule.max != null) inp.max = String(rule.max);
          inp.step = String(rule.step != null ? rule.step : "any");
          inp.title = ZH[key] + "：" + rule.hint;
        } else {
          inp.min = "0"; inp.step = "any";
        }
      }
      if (key === "model" || key === "extra_args") inp.className = "wide";
      inp.placeholder = key;
      inp.addEventListener("input", renderCmd);
      row.appendChild(inp);
    }
    pane.appendChild(row);
  };

  // 先建页签，再把字段塞进对应页签
  const buildPane = (title, index) => {
    const tab = document.createElement("button");
    tab.type = "button";
    tab.className = "tab";
    tab.dataset.tab = String(index);
    tab.innerHTML = escapeHtml(title);
    const pane = document.createElement("div");
    pane.className = "tabpane";
    pane.dataset.pane = String(index);
    bar.appendChild(tab);
    root.appendChild(pane);
    panes.push({ tab, pane });
    return pane;
  };

  GROUPS.forEach((g, i) => {
    const pane = buildPane(g[0], i);
    const gh = document.createElement("div");
    gh.className = "grouph";
    gh.textContent = g[0];
    pane.appendChild(gh);
    for (const key of g[1]) { if (!seen.has(key)) { seen.add(key); emit(key, pane); } }
  });
  // 兜底：未分组的字段放进最后一个页签
  const rest = FIELDS.filter((f) => !seen.has(f[0]));
  if (rest.length) {
    const pane = panes.length ? panes[panes.length - 1].pane : buildPane("其他", 0);
    for (const f of rest) { seen.add(f[0]); emit(f[0], pane); }
  }

  // 页签点击切换
  const select = (idx) => {
    panes.forEach((p, i) => {
      const on = i === idx;
      p.tab.classList.toggle("on", on);
      p.pane.classList.toggle("on", on);
      p.tab.setAttribute("aria-selected", on ? "true" : "false");
    });
  };
  bar.addEventListener("click", (e) => {
    const t = e.target.closest(".tab");
    if (!t) return;
    const idx = parseInt(t.dataset.tab, 10);
    select(idx);
    try { localStorage.setItem("kvmem-launcher-tab", String(idx)); } catch (err) { /* 忽略 */ }
  });
  // 记住上次打开的页签
  let start = 0;
  try {
    const saved = parseInt(localStorage.getItem("kvmem-launcher-tab"), 10);
    if (Number.isFinite(saved) && saved >= 0 && saved < panes.length) start = saved;
  } catch (e) { /* 忽略 */ }
  select(start);
}
function readForm() {
  const o = {};
  for (const [key, , kind] of FIELDS) {
    const el = $("f_" + key);
    if (!el) continue;
    o[key] = kind === "bool" ? !!el.checked : String(el.value).trim();
  }
  return o;
}
function fillForm(flags) {
  for (const [key, , kind] of FIELDS) {
    const el = $("f_" + key);
    if (!el) continue;
    const v = flags ? flags[key] : undefined;
    if (kind === "bool") {
      el.checked = v === true || v === "true";
    } else if (el.tagName === "SELECT") {
      const s = v == null ? "" : String(v);
      // 同步自运行中的服务时可能拿到下拉列表外的值：临时补一个选项，避免静默丢参数
      if (s !== "" && !Array.from(el.options).some((o) => o.value === s)) {
        const opt = document.createElement("option");
        opt.value = s;
        opt.textContent = s + "（来自运行中的服务）";
        el.appendChild(opt);
      }
      el.value = s;
    } else {
      el.value = v == null ? "" : String(v);
    }
  }
  renderCmd();
}

/* ---------- 命令行预览：逐字镜像 launcher.py build_command ---------- */
function buildCmd(flags) {
  const cmd = [CFG && CFG.exe ? String(CFG.exe) : "<exe>"];
  const model = String((flags && flags.model) || "").trim();
  if (model) cmd.push(model);
  for (const [key, flag, kind] of FIELDS) {
    if (!flag) continue;
    const v = flags ? flags[key] : undefined;
    if (kind === "bool") { if (v) cmd.push(flag); continue; }
    const s = String(v == null ? "" : v).trim();
    if (s === "" || s === "0") continue;
    cmd.push(flag, s);
  }
  const extra = String((flags && flags.extra_args) || "").trim();
  if (extra) cmd.push.apply(cmd, extra.split(/\s+/));
  return cmd;
}
function renderCmd() {
  if (STATE && STATE.state === "running" && Array.isArray(STATE.cmdline) && STATE.cmdline.length) return;
  const cmd = buildCmd(readForm());
  $("kvCmd").innerHTML = cmd.map((t, i) =>
    (i === 0 ? "<b>" + escapeHtml(t) + "</b>" : escapeHtml(t))).join(" ");
}

/* ---------- 预设 ---------- */
function presetTags(p) {
  const f = (p && p.flags) || {};
  const tags = [];
  if (f.model) {
    const base = String(f.model).split(/[\\/]/).pop();
    tags.push(["cy", base.length > 26 ? base.slice(0, 24) + "…" : base]);
  }
  if (f.port) tags.push(["am", "port " + f.port]);
  if (f.spec) tags.push(["", String(f.spec)]);
  if (f.draft_tokens) tags.push(["", "draft " + f.draft_tokens]);
  if (f.max_context) tags.push(["", "ctx " + fmtInt(f.max_context)]);
  return tags;
}
function renderPresets() {
  const box = $("presetList");
  box.innerHTML = "";
  const presets = (CFG && CFG.presets) || [];
  if (!presets.length) {
    box.innerHTML = '<div style="font-family:var(--mono);font-size:11px;color:var(--faint)">（暂无预设）</div>';
    return;
  }
  presets.forEach((p, i) => {
    const card = document.createElement("div");
    card.className = "pcard" + (CFG && CFG.active === i ? " active" : "");
    const tags = presetTags(p).map((t) =>
      '<span class="tag ' + t[0] + '">' + escapeHtml(t[1]) + "</span>").join("");
    card.innerHTML =
      '<div class="nm">' + escapeHtml(p.name || ("预设 " + (i + 1))) + "</div>" +
      '<div class="meta">' + tags + "</div>" +
      '<div class="ops">' +
        '<button class="btn sm" data-op="load">载入</button>' +
        '<button class="btn sm" data-op="active">设为主用</button>' +
        '<button class="btn sm danger" data-op="del">删除</button>' +
      "</div>" +
      (CFG && CFG.active === i ? '<div class="pbadge">● 主用</div>' : "");
    card.addEventListener("click", async (e) => {
      const op = e.target && e.target.dataset ? e.target.dataset.op : null;
      if (op === "del") {
        if (presets.length <= 1) { toast("至少保留一个预设", true); return; }
        if (!confirm('删除预设「' + (p.name || i) + '」？')) return;
        const next = presets.filter((_, k) => k !== i);
        const act = CFG.active > i ? CFG.active - 1 : (CFG.active === i ? 0 : CFG.active);
        await postConfig({ presets: next, active: Math.min(act, Math.max(0, next.length - 1)) });
        toast("已删除预设");
        return;
      }
      if (op === "active") { await postConfig({ active: i }); toast("已设为主用预设"); return; }
      applyPreset(i);
      toast("已载入预设：" + (p.name || i));
    });
    box.appendChild(card);
  });
}
function applyPreset(i) {
  const p = CFG && CFG.presets && CFG.presets[i];
  if (!p) return;
  const flags = Object.assign({}, p.flags || {});
  if (flags.port == null && CFG.upstream) flags.port = CFG.upstream.port;
  fillForm(flags);
}
async function postConfig(patch) {
  try {
    const c = await jpost("/api/config", patch);
    if (!c || !c.ok) { toast("保存失败：" + ((c && c.error) || "未知错误"), true); return false; }
    CFG = c.config;
    renderPresets();
    renderCmd();
    return true;
  } catch (e) {
    toast("保存失败：" + e.message, true);
    return false;
  }
}
$("btnSaveActive").addEventListener("click", async () => {
  if (!CFG || !CFG.presets || !CFG.presets.length) { toast("没有可用的主用预设", true); return; }
  const idx = CFG.active || 0;
  const presets = CFG.presets.map((p, i) => i === idx ? { name: p.name, flags: readForm() } : p);
  if (await postConfig({ presets })) toast("已保存到主用预设：" + (CFG.presets[idx].name || idx));
});
$("btnSaveNew").addEventListener("click", async () => {
  const name = prompt("新预设名称：", "我的预设");
  if (name == null) return;
  const presets = ((CFG && CFG.presets) || []).concat([{ name: name.trim() || "预设", flags: readForm() }]);
  if (await postConfig({ presets, active: presets.length - 1 })) toast("已另存为新预设");
});
$("btnReset").addEventListener("click", () => {
  if (!CFG || !CFG.presets || !CFG.presets.length) return;
  applyPreset(CFG.active || 0);
  toast("已还原主用预设");
});

/* ---------- 从运行中的上游同步参数 ---------- */
$("btnSync").addEventListener("click", async () => {
  try {
    const r = await jget("/api/upstream/v1/models");
    const m = r && r.data && r.data[0];
    if (!m) { toast("无法获取上游模型信息", true); return; }
    const raw = (m.status && m.status.args) || [];
    const tokens = Array.isArray(raw) ? raw.map(String) : String(raw).split(/\s+/);
    const flags = {};
    let n = 0;
    for (let i = 0; i < tokens.length; i++) {
      const t = tokens[i];
      if (t.slice(0, 2) !== "--") continue;
      const key = FLAG2KEY[t];
      if (!key) continue;
      const kind = (FIELDS.find((f) => f[0] === key) || [])[2];
      if (kind === "bool") { flags[key] = true; n++; continue; }
      const v = tokens[i + 1];
      if (v != null && v.slice(0, 2) !== "--") { flags[key] = v; i++; n++; }
    }
    fillForm(flags);
    toast("已从运行中的服务同步 " + n + " 项参数");
  } catch (e) {
    toast("同步失败：" + e.message, true);
  }
});

/* ---------- 状态 ---------- */
function isManaged(st) { return !!st && st.pid != null && (st.state === "starting" || st.state === "running"); }
function isExternal(st) { return !!st && !isManaged(st) && !!st.upstream && st.upstream.health === "ok"; }
function setMsg(text, cls) {
  const el = $("stMsg");
  el.textContent = text;
  el.className = "msg" + (cls ? " " + cls : "");
}
function renderState() {
  const st = STATE || {};
  const managed = isManaged(st), external = isExternal(st);
  /* launcher.py 在无受管进程但上游健康时会把 state 置为 "running"（pid=None）。
     这种「外部服务」必须优先于 state 判断，否则会误显示为绿色「运行中」。 */
  const disp = external ? "external" : st.state;
  $("led").className = "led " + (
    disp === "running" ? "ok" :
    disp === "starting" ? "busy" :
    disp === "exited" ? "err" :
    disp === "external" ? "ext" : ""
  );
  const stateText = {
    stopped: "已停止", starting: "启动中…", running: "运行中", exited: "已退出",
    external: "外部服务"
  }[disp] || st.state || "—";
  $("kvState").textContent = stateText;
  $("kvPid").textContent = st.pid != null ? String(st.pid) : "—";
  $("kvStart").textContent = st.started_at ? new Date(st.started_at * 1000).toLocaleString("zh-CN") : "—";
  $("kvExit").textContent = st.exit_code != null ? String(st.exit_code) : "—";
  const up = st.upstream || {};
  const hc = up.health === "ok" ? "ok" : (up.health === "busy" ? "busy" : "bad");
  const hEl = $("kvHealth");
  hEl.textContent = "";
  const dot = document.createElement("span");
  dot.className = 'dot ' + hc;
  hEl.appendChild(dot);
  hEl.appendChild(document.createTextNode(up.health || "unreachable"));
  $("kvUp").textContent = (up.host || "127.0.0.1") + ":" + (up.port != null ? up.port : "—");
  $("stTitle").textContent = "ninfer · " + (up.host || "127.0.0.1") + ":" + (up.port != null ? up.port : "—");
  $("hModel").textContent = up.model || "—";
  $("btnStart").disabled = managed || external;
  $("btnStop").disabled = !managed;
  if (managed && Array.isArray(st.cmdline) && st.cmdline.length) {
    $("kvCmd").innerHTML = st.cmdline.map((t, i) =>
      (i === 0 ? "<b>" + escapeHtml(t) + "</b>" : escapeHtml(t))).join(" ");
  } else {
    renderCmd();
  }
  if (!STATE) setMsg("尚未连接启动器后端…", "bad");
  else if (external) setMsg("端口 " + up.port + " 已检测到外部运行服务（不受本启动器管理）。启动已禁用；请先停止它或改用其它端口。", "bad");
  else if (managed && st.state === "starting") setMsg("正在启动服务，等待端口就绪…", "");
  else if (managed) setMsg("受管进程运行中（PID " + st.pid + "）", "good");
  else if (st.state === "exited") setMsg("受管进程已退出（exit " + st.exit_code + "）", "bad");
  else setMsg("服务未运行。可调整参数后点击「启动服务」。", "");
}
async function pollState() {
  try {
    STATE = await jget("/api/state");
    if (STATE && STATE.upstream && STATE.upstream.model) $("hModel").textContent = STATE.upstream.model;
  } catch (e) {
    STATE = null;
  }
  renderState();
}

/* ---------- 启动 / 停止 ---------- */
$("btnStart").addEventListener("click", async () => {
  $("btnStart").disabled = true;
  setMsg("正在保存预设并启动…", "");
  try {
    const idx = CFG ? (CFG.active || 0) : 0;
    if (CFG && CFG.presets && CFG.presets.length) {
      const presets = CFG.presets.map((p, i) => i === idx ? { name: p.name, flags: readForm() } : p);
      await postConfig({ presets });
    }
    const j = await jpost("/api/server/start", { preset: readForm() });
    if (j && j.ok) {
      toast("已启动，PID " + j.pid);
      setMsg("已启动（PID " + j.pid + "），等待模型加载…", "good");
    } else if (j && j.external) {
      toast(j.error || "端口已有外部服务", true);
      setMsg(j.error || "端口已有外部服务", "bad");
    } else {
      toast((j && j.error) || "启动失败", true);
      setMsg((j && j.error) || "启动失败", "bad");
    }
  } catch (e) {
    toast("启动失败：" + e.message, true);
    setMsg("启动失败：" + e.message, "bad");
  }
  await pollState();
});
$("btnStop").addEventListener("click", async () => {
  $("btnStop").disabled = true;
  setMsg("正在停止…", "");
  try {
    const j = await jpost("/api/server/stop", {});
    toast(j && j.ok ? "已停止" : ((j && j.error) || "停止失败"), !(j && j.ok));
  } catch (e) {
    toast("停止失败：" + e.message, true);
  }
  await pollState();
});

/* ---------- 日志 ---------- */
function logVisible(l) {
  const f = $("logFilter").value.trim().toLowerCase();
  return !f || String(l.line).toLowerCase().indexOf(f) >= 0;
}
function appendLog(l) {
  logLines.push(l);
  if (logLines.length > 4000) logLines = logLines.slice(-4000);
  $("logCnt").textContent = logLines.length + " 行";
  if (!logVisible(l)) return;
  const view = $("logView");
  const nearBottom = view.scrollHeight - view.scrollTop - view.clientHeight < 40;
  const div = document.createElement("div");
  div.innerHTML = '<span class="lt">' + escapeHtml(l.t) + "</span>" + escapeHtml(l.line);
  view.appendChild(div);
  while (view.childElementCount > 1500) view.removeChild(view.firstChild);
  if (nearBottom && $("logAuto").checked) view.scrollTop = view.scrollHeight;
}
function rerenderLog() {
  const view = $("logView");
  view.innerHTML = "";
  const rows = logLines.filter(logVisible).slice(-1200);
  const frag = document.createDocumentFragment();
  for (const l of rows) {
    const div = document.createElement("div");
    div.innerHTML = '<span class="lt">' + escapeHtml(l.t) + "</span>" + escapeHtml(l.line);
    frag.appendChild(div);
  }
  view.appendChild(frag);
  view.scrollTop = view.scrollHeight;
}
$("logFilter").addEventListener("input", rerenderLog);
async function pollLog() {
  if (!STATE) return;
  try {
    const j = await jget("/api/server/log?after=" + logNext);
    const lines = (j && j.lines) || [];
    for (const l of lines) appendLog(l);
    logNext = j && j.next != null ? j.next : logNext + lines.length;
  } catch (e) { /* 后端短暂不可用，忽略 */ }
}

/* ---------- 指标 ---------- */
function setVal(id, text) {
  const el = $(id);
  if (!el || el.textContent === text) return;
  el.textContent = text;
  const card = el.closest(".mcard");
  if (card) { card.classList.remove("flash"); void card.offsetWidth; card.classList.add("flash"); }
}
function cssVar(name, fallback) {
  const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  return v || fallback;
}
function drawSpark() {
  const cv = $("spark");
  if (!cv) return;
  const dpr = window.devicePixelRatio || 1;
  const w = cv.clientWidth, h = cv.clientHeight;
  if (!w || !h) return;
  if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }
  const ctx = cv.getContext("2d");
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  // 网格与曲线颜色跟随主题
  ctx.strokeStyle = cssVar("--line2", "rgba(125,180,255,.20)");
  ctx.lineWidth = 1;
  for (let i = 1; i < 4; i++) {
    const y = (h / 4) * i;
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
  }
  const cDec = cssVar("--cyan", "#3fd8ff");
  const cPre = cssVar("--amber", "#ffb454");
  const all = spark.dec.concat(spark.pre);
  const max = Math.max(20, Math.max.apply(null, all.length ? all : [0]));
  const draw = (arr, color) => {
    if (arr.length < 2) return;
    ctx.beginPath();
    arr.forEach((v, i) => {
      const x = (i / (arr.length - 1)) * w;
      const y = h - (v / max) * (h - 8) - 2;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.8;
    ctx.stroke();
  };
  draw(spark.pre, cPre);
  draw(spark.dec, cDec);
}
function parseMetrics(text) {
  const m = {};
  for (const line of String(text).split(/\r?\n/)) {
    if (!line || line.charAt(0) === "#") continue;
    const i = line.lastIndexOf(" ");
    if (i <= 0) continue;
    const name = line.slice(0, i).trim();
    const v = parseFloat(line.slice(i + 1));
    if (name && Number.isFinite(v)) m[name] = v;
  }
  return m;
}
function mget(name) { return METRICS[name] != null ? METRICS[name] : null; }
/* 上游不可达时清空卡片，避免把上一轮的旧值当成实时数据 */
function clearMetrics(reason) {
  METRICS = {};
  STATS = null;
  for (const [v, s] of [["vDec", "sDec"], ["vPre", "sPre"], ["vMtp", "sMtp"], ["vMtpA", "sMtpA"],
                        ["vPred", "sPred"], ["vPrompt", "sPrompt"], ["vKv", "sKv"], ["vUp", "sUp"]]) {
    setVal(v, "—");
    setVal(s, reason);
  }
  $("hDec").textContent = "—";
  $("hPre").textContent = "—";
  $("hMtp").textContent = "—";
  $("hUp").textContent = "—";
}
async function pollMetrics() {
  const health = STATE && STATE.upstream ? STATE.upstream.health : "unreachable";
  if (health !== "ok") {
    clearMetrics(health === "busy" ? "上游忙" : "上游不可达");
    return;
  }
  let stats = null, met = null;
  try { stats = await jget("/api/upstream/stats"); } catch (e) { /* 忽略 */ }
  try { met = parseMetrics(await tget("/api/upstream/metrics")); } catch (e) { /* 忽略 */ }
  if (!stats) { clearMetrics("指标不可达"); return; }
  STATS = stats;
  METRICS = met || {};

  const tps = stats.throughput_tokens_per_second || {};
  const toks = stats.tokens || {};
  const cap = stats.capacity || {};
  const reqs = stats.requests || {};
  const kv = stats.kvmem || {};

  /* 速度口径：优先 /metrics 的执行时间平均（服务端自报的 tok/s，与 llama.cpp eval rate 一致）；
     /stats.throughput_tokens_per_second 是「总运行时间」摊销值（含空闲），仅作回退 */
  const dec = mget("llamacpp:predicted_tokens_seconds") != null ? mget("llamacpp:predicted_tokens_seconds") : tps.decode;
  const pre = mget("llamacpp:prompt_tokens_seconds") != null ? mget("llamacpp:prompt_tokens_seconds") : tps.prefill;
  const dn = mget("ninfer:draft_tokens_total");
  const da = mget("ninfer:draft_accepted_tokens_total");
  const acc = (dn != null && dn > 0 && da != null) ? (da / dn * 100) : null;
  const nDec = mget("llamacpp:n_decode_total");
  const pSec = mget("llamacpp:prompt_seconds_total");
  const reused = mget("ninfer:reused_prompt_tokens_total");
  const uptime = stats.uptime_seconds != null ? stats.uptime_seconds : mget("ninfer:uptime_seconds");

  setVal("vDec", fmt1(dec));
  setVal("sDec", nDec ? ("解码 " + fmtInt(nDec) + " 轮 · 执行 " + fmt1(mget("llamacpp:tokens_predicted_seconds_total")) + " s") : "—");

  setVal("vPre", fmt1(pre));
  setVal("sPre", "执行 " + fmt1(pSec) + " s · 缓存命中 " + fmtInt(reused) + " tok");

  setVal("vMtp", acc == null ? "—" : acc.toFixed(1));
  setVal("sMtp", dn != null ? ("接受 " + fmtInt(da) + " / 草稿 " + fmtInt(dn)) : "未启用或暂无数据");

  setVal("vMtpA", dn != null ? fmtInt(dn) : "—");
  setVal("sMtpA", dn != null ? ("拒绝 " + fmtInt((dn || 0) - (da || 0)) + " · 请求 " + fmtInt(mget("ninfer:requests_total"))) : "—");

  setVal("vPred", fmtInt(toks.committed_decode));
  setVal("sPred", "解码轮次 " + fmtInt(nDec));

  setVal("vPrompt", fmtInt(toks.computed_prefill));
  setVal("sPrompt", "Prefill 耗时 " + fmt1(pSec) + " s · 分块 " + fmtInt(kv.evaluated_tokens));

  setVal("vKv", fmtInt(cap.kv_capacity_tokens));
  setVal("sKv", "最大上下文 " + fmtInt(cap.max_context) + " · 页 " + fmtInt(cap.kv_capacity_pages));

  setVal("vUp", fmtDur(uptime));
  setVal("sUp", "引擎 ninfer · 恢复 " + fmtInt(mget("ninfer:engine_recoveries_total")));

  $("hDec").textContent = fmt1(dec);
  $("hPre").textContent = fmt1(pre);
  $("hMtp").textContent = acc == null ? "—" : acc.toFixed(1) + "%";
  $("hUp").textContent = fmtDur(uptime);

  if (Number.isFinite(dec)) spark.dec.push(dec);
  if (Number.isFinite(pre)) spark.pre.push(pre);
  if (spark.dec.length > SPARK_MAX) spark.dec = spark.dec.slice(-SPARK_MAX);
  if (spark.pre.length > SPARK_MAX) spark.pre = spark.pre.slice(-SPARK_MAX);
  drawSpark();
}

/* ---------- 本机资源：CPU / GPU 显存 / 内存（来自 /api/sys） ---------- */
function setBar(id, pct) {
  const el = $(id);
  if (!el) return;
  const v = Number(pct);
  if (!Number.isFinite(v)) { el.style.width = "0"; el.className = ""; return; }
  el.style.width = Math.max(0, Math.min(100, v)) + "%";
  el.className = v >= 90 ? "hot" : (v >= 70 ? "warn" : "");
}
function fmtGiB(v) {
  return v == null || !Number.isFinite(Number(v)) ? "—" : Number(v).toFixed(1);
}
async function pollSys() {
  let s = null;
  try { s = await jget("/api/sys"); } catch (e) { s = null; }
  if (!s) {
    for (const [v, b, sub] of [["vCpu", "bCpu", "sCpu"], ["vVram", "bVram", "sVram"],
                               ["vRam", "bRam", "sRam"], ["vGpu", "bGpu", "sGpu"],
                               ["vGpuW", "bGpuW", "sGpuW"], ["vSysW", "bSysW", "sSysW"]]) {
      setVal(v, "—"); setBar(b, null); setVal(sub, "监控不可用");
    }
    return;
  }

  // CPU
  const cpu = s.cpu || {};
  const cp = cpu.percent;
  setVal("vCpu", cp == null ? "—" : fmt1(cp));
  setBar("bCpu", cp);
  setVal("sCpu", (cpu.count ? cpu.count + " 逻辑核" : "本机 CPU") +
    (cpu.error ? " · " + cpu.error : ""));

  // 系统内存
  const mem = s.mem || {};
  setVal("vRam", mem.percent == null ? "—" : String(mem.percent));
  setBar("bRam", mem.percent);
  setVal("sRam", mem.total_gib
    ? (fmtGiB(mem.used_gib) + " / " + fmtGiB(mem.total_gib) + " GiB")
    : "不可用");

  // GPU 显存 + 利用率 + 功耗
  const gpu = s.gpu || {};
  const g0 = (gpu.items || [])[0];
  if (g0) {
    setVal("vVram", g0.mem_percent == null ? "—" : fmt1(g0.mem_percent));
    setBar("bVram", g0.mem_percent);
    setVal("sVram", fmtInt(g0.mem_used_mib) + " / " + fmtInt(g0.mem_total_mib) + " MiB");
    setVal("vGpu", g0.util_percent == null ? "—" : String(g0.util_percent));
    setBar("bGpu", g0.util_percent);
    const extra = [];
    if (g0.temp_c != null) extra.push(g0.temp_c + "°C");
    if ((gpu.items || []).length > 1) extra.push(gpu.items.length + " 块 GPU");
    setVal("sGpu", (g0.name || "GPU") + (extra.length ? " · " + extra.join(" · ") : ""));
    const card = $("vGpu").closest(".mcard");
    if (card) card.title = (g0.name || "GPU") + " · 显存 " + g0.mem_used_mib + "/" +
      g0.mem_total_mib + " MiB · 利用率 " + g0.util_percent + "% · " + g0.temp_c + "°C";
  } else {
    const why = !gpu.available ? "未找到 nvidia-smi" : (gpu.error || "无 NVIDIA GPU");
    setVal("vVram", "—"); setBar("bVram", null); setVal("sVram", why);
    setVal("vGpu", "—"); setBar("bGpu", null); setVal("sGpu", why);
  }

  // ---- 功耗 ----
  // 显卡功耗是 nvidia-smi 实测值；整机为线性模型估算（见 launcher.py 注释）
  const pw = s.power || {};
  const gw = pw.gpu_w, gl = pw.gpu_limit_w;
  setVal("vGpuW", gw == null ? "—" : fmt1(gw));
  setBar("bGpuW", pw.gpu_percent);
  setVal("sGpuW", gl ? ("上限 " + fmt1(gl) + " W") : (gw == null ? "不支持功耗查询" : "—"));
  const gpCard = $("vGpuW") && $("vGpuW").closest(".mcard");
  if (gpCard) gpCard.title = (g0 && g0.name ? g0.name : "GPU") +
    (gw != null ? " 功耗 " + fmt1(gw) + " W" : " 功耗不可用") +
    (gl ? " · 功耗墙 " + fmt1(gl) + " W" : "");

  const sw = pw.system_w;
  setVal("vSysW", sw == null ? "—" : fmt1(sw));
  // 估算值无固定满量程，用 400W 作参考量程做进度条示意
  setBar("bSysW", sw == null ? null : Math.min(100, sw / 400 * 100));
  const parts = pw.system_parts || {};
  const seg = [];
  if (gw != null) seg.push("显卡 " + fmt1(gw));
  if (parts.cpu_w != null) seg.push("CPU " + fmt1(parts.cpu_w));
  if (parts.mem_w != null) seg.push("内存 " + fmt1(parts.mem_w));
  if (parts.other_w != null) seg.push("其它 " + fmt1(parts.other_w));
  setVal("sSysW", seg.length ? seg.join(" + ") : "估算不可用");
  const swCard = $("vSysW") && $("vSysW").closest(".mcard");
  if (swCard) swCard.title = "整机功耗为估算值（±30%），非实测\n" +
    (seg.length ? seg.join(" + ") + " ≈ " + fmt1(sw) + " W" : "");
}

/* ---------- 对话测试（SSE 流式 + 逐段耗时） ---------- */
function liveChip(cls, text) {
  const s = document.createElement("span");
  s.className = "lv " + (cls || "");
  s.textContent = text;
  $("chatLive").appendChild(s);
  return s;
}
const TIMING_ROWS = [
  ["cache_n", "缓存命中 tokens", "int"],
  ["prompt_n", "实际 Prefill tokens", "int"],
  ["prompt_ms", "Prefill 耗时", "ms"],
  ["prompt_per_token_ms", "每 token Prefill", "ms"],
  ["prompt_per_second", "Prefill 速度", "tps"],
  ["predicted_n", "生成 tokens", "int"],
  ["predicted_ms", "生成耗时", "ms"],
  ["predicted_per_token_ms", "每 token 生成", "ms"],
  ["predicted_per_second", "生成速度", "tps"],
  ["draft_n", "MTP 草稿 tokens", "int"],
  ["draft_n_accepted", "MTP 接受 tokens", "int"]
];
function fmtTiming(kind, v) {
  if (v == null || !Number.isFinite(Number(v))) return null;
  if (kind === "int") return fmtInt(v);
  if (kind === "ms") return (Math.round(Number(v) * 10) / 10) + " ms";
  if (kind === "tps") return (Math.round(Number(v) * 10) / 10) + " tok/s";
  return String(v);
}
function showTimings(tm) {
  if (!tm) return;
  const rows = [];
  for (const r of TIMING_ROWS) {
    const s = fmtTiming(r[2], tm[r[0]]);
    if (s != null) rows.push([r[1] + " (" + r[0] + ")", s]);
  }
  if (tm.draft_n > 0 && tm.draft_n_accepted != null) {
    rows.push(["MTP 接受率", (tm.draft_n_accepted / tm.draft_n * 100).toFixed(2) + " %"]);
  }
  if (!rows.length) return;
  $("timingsBody").innerHTML = rows.map((r) =>
    "<tr><td>" + escapeHtml(r[0]) + "</td><td>" + escapeHtml(r[1]) + "</td></tr>").join("");
  $("timingsTbl").style.display = "";
}
$("btnChat").addEventListener("click", async () => {
  const text = $("chatIn").value.trim();
  if (!text || chatBusy) return;
  if (!(STATE && STATE.upstream && STATE.upstream.health === "ok")) {
    toast("上游服务不可用，请先启动服务", true);
    return;
  }
  chatBusy = true;
  $("btnChat").disabled = true;
  $("chatOut").innerHTML = "";
  $("chatLive").innerHTML = "";
  $("timingsTbl").style.display = "none";
  lastTimings = null;

  const form = readForm();
  const model = (STATE.upstream && STATE.upstream.model) || form.model_id || "ninfer-27b";
  const body = {
    model: model,
    messages: [{ role: "user", content: text }],
    stream: true,
    max_tokens: Math.max(1, Math.round(num($("chatMax").value, 128))),
    temperature: num($("chatTemp").value, 0.6),
    timings_per_token: true
  };
  const t0 = performance.now();
  let firstTok = null, nChunk = 0, chars = 0;
  let streamChip = null;
  const out = $("chatOut");
  const cursor = document.createElement("span");
  cursor.className = "cur";
  out.appendChild(cursor);
  try {
    const r = await fetch("/api/upstream/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });
    if (!r.ok) {
      out.textContent = "HTTP " + r.status + " " + (await r.text()).slice(0, 400);
      throw new Error("HTTP " + r.status);
    }
    const reader = r.body.getReader();
    const dec = new TextDecoder();
    let buf = "";
    for (;;) {
      const step = await reader.read();
      if (step.done) break;
      buf += dec.decode(step.value, { stream: true });
      let idx;
      while ((idx = buf.indexOf("\n")) >= 0) {
        const line = buf.slice(0, idx).replace(/\r$/, "");
        buf = buf.slice(idx + 1);
        if (line.slice(0, 5) !== "data:") continue;
        const payload = line.slice(5).trim();
        if (payload === "[DONE]") continue;
        let obj;
        try { obj = JSON.parse(payload); } catch (e) { continue; }
        const delta = obj.choices && obj.choices[0] && obj.choices[0].delta;
        if (delta && typeof delta.content === "string" && delta.content) {
          if (firstTok == null) {
            firstTok = performance.now();
            liveChip("cy", "首字 " + Math.round(firstTok - t0) + " ms");
          }
          chars += delta.content.length;
          out.insertBefore(document.createTextNode(delta.content), cursor);
          out.scrollTop = out.scrollHeight;
        }
        if (obj.timings) { lastTimings = obj.timings; nChunk++; }
        if (obj.timings && nChunk % 8 === 0) {
          const now = performance.now();
          const text = "流式 " + chars + " 字 · " + ((now - t0) / 1000).toFixed(1) + " s";
          if (streamChip) streamChip.textContent = text;
          else streamChip = liveChip("", text);
        }
      }
    }
  } catch (e) {
    if (!out.textContent) out.textContent = "请求失败：" + e.message;
    toast("对话请求失败：" + e.message, true);
  }
  if (cursor.parentNode) cursor.parentNode.removeChild(cursor);
  const total = (performance.now() - t0) / 1000;
  liveChip("am", "总耗时 " + total.toFixed(2) + " s");
  if (lastTimings) {
    if (Number.isFinite(Number(lastTimings.predicted_per_second))) {
      liveChip("gr", fmt1(lastTimings.predicted_per_second) + " tok/s");
    }
    if (lastTimings.draft_n > 0 && lastTimings.draft_n_accepted != null) {
      liveChip("gr", "MTP 接受率 " + (lastTimings.draft_n_accepted / lastTimings.draft_n * 100).toFixed(1) + "%");
    }
    if (lastTimings.cache_n != null) liveChip("", "缓存命中 " + fmtInt(lastTimings.cache_n));
    showTimings(lastTimings);
  }
  chatBusy = false;
  $("btnChat").disabled = false;
});
/* ---------- 输入框：中文输入法（IME）兼容 ----------
   中文/日文输入法用 Enter 确认候选词。若把这次 Enter 当成"发送"并
   preventDefault()，候选词就提交不上去 —— 表现就是"无法输入中文"。

   不同浏览器/输入法的按键序列并不一致，这里逐一覆盖：
     Chrome/Edge(微软拼音)  keydown(isComposing=true, keyCode=229) → compositionend
     Firefox               keydown(isComposing=true)
     Safari / 部分输入法     keydown(keyCode=229) 且 isComposing=false
     少数实现               compositionend 先于 keydown(Enter) 到达  ← 时间戳兜底
   只要命中任意一条，就把这次 Enter 交还给输入法，不发送。 */
let chatComposing = false;
let chatCompositionEndAt = 0;
const chatIn = $("chatIn");
chatIn.addEventListener("compositionstart", () => { chatComposing = true; });
chatIn.addEventListener("compositionend", () => {
  chatComposing = false;
  chatCompositionEndAt = Date.now();
});
chatIn.addEventListener("keydown", (e) => {
  // 只关心 Enter（含 IME 的 Process/229）
  if (e.key !== "Enter" && e.key !== "Process" && e.keyCode !== 229) return;

  // 1) 正在组合中：这次 Enter 是"确认候选词"，交还输入法
  if (chatComposing || e.isComposing) return;
  // 2) IME 标志位：keyCode 229 表示按键被输入法吞掉了
  if (e.keyCode === 229 || e.key === "Process") return;
  // 3) 组合刚刚结束（同一按键的提交 Enter 先触发 compositionend 再触发 keydown）：
  //    极短窗口内的 Enter 视为上屏动作，不发送
  if (Date.now() - chatCompositionEndAt < 80) return;

  // Shift+Enter 换行
  if (e.shiftKey) return;
  // 真正的发送
  e.preventDefault();
  $("btnChat").click();
});

/* ---------- 主题按钮绑定 ---------- */
$("btnTheme").addEventListener("click", toggleTheme);
document.addEventListener("keydown", (e) => {
  // 快捷键 T：不在输入框里、且没有按修饰键时切换主题
  if (e.key !== "t" && e.key !== "T") return;
  if (e.ctrlKey || e.altKey || e.metaKey) return;
  const tag = (e.target && e.target.tagName) || "";
  if (tag === "INPUT" || tag === "TEXTAREA") return;
  toggleTheme();
});
/* 默认主题固定为亮色（白色 UI），不跟随系统 —— 用户显式切换过才使用其选择。
   因此这里不监听 prefers-color-scheme，避免"默认白色"的预期被系统设置覆盖。 */

/* ---------- 初始化 ---------- */
(async function init() {
  applyTheme(currentTheme(), false);   // 同步按钮图标/文案（引导脚本已设好 data-theme）
  buildForm();
  try {
    CFG = await jget("/api/config");
  } catch (e) {
    toast("无法连接 launcher 后端：请先运行 start-launcher.bat", true);
    setMsg("无法连接 launcher 后端（127.0.0.1:18300）：" + e.message, "bad");
    return;
  }
  const idx = CFG.active != null && CFG.presets && CFG.presets[CFG.active] ? CFG.active : 0;
  applyPreset(idx);
  renderPresets();
  await pollState();
  await pollLog();
  await pollSys();
  await pollMetrics();
  setInterval(pollState, 2000);
  setInterval(pollLog, 2000);
  setInterval(pollSys, 2000);
  setInterval(pollMetrics, 2000);
  window.addEventListener("resize", drawSpark);
})();

</script>
</body>
</html>
